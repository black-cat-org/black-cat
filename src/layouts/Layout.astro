---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Black Cat - Desarrollo Web Premium',
  description = 'Especialistas en desarrollo web con React, Astro, NestJS, Flutter y más. Creamos soluciones digitales rápidas, escalables y optimizadas para tu negocio.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="desarrollo web, React, Astro, NestJS, Flutter, apps móviles, diseño UI/UX, hosting, SSL, tienda virtual" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-black text-white antialiased">
    <slot />
  </body>
</html>
