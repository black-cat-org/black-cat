---
import { siteConfig, whatsappUrl } from '../../config/site';

const services = [
  { name: 'Desarrollo Web', href: '/servicios/desarrollo-web' },
  { name: 'Backend & APIs', href: '/servicios/backend-apis' },
  { name: 'Apps Móviles', href: '/servicios/apps-moviles' },
  { name: 'Diseño UI/UX', href: '/servicios/diseno-uiux' },
  { name: 'E-commerce', href: '/servicios/ecommerce' },
  { name: 'Hosting & SSL', href: '/servicios/hosting-ssl' },
];

// Iconos Lucide outline (lucide.dev). stroke-width 1.5, currentColor.
const socialLinks = [
  {
    name: 'Instagram',
    url: siteConfig.social.instagram,
    icon: '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>',
  },
  {
    name: 'LinkedIn',
    url: siteConfig.social.linkedin,
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    name: 'GitHub',
    url: siteConfig.social.github,
    icon: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  },
  {
    name: 'X',
    url: siteConfig.social.twitter,
    icon: '<path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/>',
  },
  {
    name: 'YouTube',
    url: siteConfig.social.youtube,
    icon: '<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>',
  },
  {
    name: 'TikTok',
    url: siteConfig.social.tiktok,
    icon: '<path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>',
  },
].filter((s) => s.url !== null);
---

<footer class="bg-linear-to-b from-black to-gray-900 border-t border-gray-800">
  <!-- CTA Section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="bg-linear-to-r from-purple-600 to-pink-600 rounded-2xl p-12 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        ¿Listo para iniciar tu proyecto?
      </h2>
      <p class="text-xl text-purple-100 mb-8 max-w-2xl mx-auto">
        Hablemos de cómo podemos ayudarte a alcanzar tus objetivos digitales
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contacto"
          class="px-8 py-4 bg-white text-purple-600 hover:bg-gray-100 rounded-lg font-medium transition-all shadow-lg"
        >
          Solicitar Cotización
        </a>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-white/10 hover:bg-white/20 border border-white/30 text-white rounded-lg font-medium transition-all"
        >
          Contactar por WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-2">
        <a href="/" class="flex items-center gap-2 mb-4" aria-label={`${siteConfig.name} — Inicio`}>
          <span class="text-3xl" aria-hidden="true">🐈‍⬛</span>
          <span class="text-2xl font-bold text-white">{siteConfig.name}</span>
        </a>
        <p class="text-gray-400 mb-6 max-w-md">
          Desarrollo de software a medida — web, backend, móvil, e-commerce. Basados en {siteConfig.location.city}, {siteConfig.location.country}.
        </p>
        {socialLinks.length > 0 && (
          <ul class="flex gap-4 list-none p-0">
            {socialLinks.map((item) => (
              <li>
                <a
                  href={item.url!}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-10 h-10 bg-gray-800 hover:bg-purple-600 rounded-lg flex items-center justify-center text-gray-300 hover:text-white transition-colors"
                  aria-label={item.name}
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={item.icon}
                  />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-semibold mb-4">Servicios</h3>
        <ul class="space-y-2">
          {services.map((service) => (
            <li>
              <a
                href={service.href}
                class="text-gray-400 hover:text-purple-400 transition-colors text-sm"
              >
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold mb-4">Contacto</h3>
        <ul class="space-y-2 text-sm text-gray-400">
          <li>
            <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-purple-400 transition-colors">
              {siteConfig.contact.email}
            </a>
          </li>
          <li>
            <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="hover:text-purple-400 transition-colors">
              WhatsApp
            </a>
          </li>
          <li>{siteConfig.location.city}, {siteConfig.location.country}</li>
          <li>{siteConfig.hours.label}</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
        <p class="text-gray-400 text-sm">
          © {new Date().getFullYear()} {siteConfig.name}. Todos los derechos reservados.
        </p>
        <div class="flex gap-6 text-sm text-gray-400">
          <a href="/privacidad" class="hover:text-purple-400 transition-colors">
            Privacidad
          </a>
          <a href="/terminos" class="hover:text-purple-400 transition-colors">
            Términos
          </a>
          <a href="/cookies" class="hover:text-purple-400 transition-colors">
            Cookies
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
