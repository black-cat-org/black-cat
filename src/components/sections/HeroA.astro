---
import { whatsappUrl } from '../../config/site';
import { HERO_COPY } from './hero-shared';
---

<!-- Hero A — Mínimo (baseline). 0 KB JS extra. Solo CSS. -->
<section class="relative min-h-dvh flex items-center justify-center overflow-hidden pt-16">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-linear-to-br from-purple-900/20 via-black to-blue-900/20" aria-hidden="true"></div>

  <!-- Floating blobs (CSS animation) -->
  <div class="absolute top-20 left-10 w-72 h-72 bg-purple-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob" aria-hidden="true"></div>
  <div class="absolute top-40 right-10 w-72 h-72 bg-blue-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000" aria-hidden="true"></div>
  <div class="absolute bottom-20 left-1/2 w-72 h-72 bg-pink-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000" aria-hidden="true"></div>

  <div class="hero-a-content relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-20">
    <div class="space-y-8">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-600/10 border border-purple-600/20 rounded-full text-sm text-purple-400">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
        </span>
        {HERO_COPY.badge}
      </div>

      <!-- Heading -->
      <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold">
        <span class="block text-white">{HERO_COPY.title.line1}</span>
        <span class="block bg-linear-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent">
          {HERO_COPY.title.line2Gradient}
        </span>
      </h1>

      <!-- Description -->
      <p class="max-w-2xl mx-auto text-lg sm:text-xl text-gray-400 leading-relaxed">
        {HERO_COPY.description}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-4">
        <a
          href={HERO_COPY.ctaPrimary.href}
          class="px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50 text-lg"
        >
          {HERO_COPY.ctaPrimary.label}
        </a>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 border-2 border-purple-600 text-purple-400 hover:bg-purple-600 hover:text-white rounded-lg font-medium transition-all text-lg inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
          </svg>
          {HERO_COPY.ctaSecondary.label}
        </a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-8 max-w-2xl mx-auto pt-12">
        {HERO_COPY.stats.map((s) => (
          <div>
            <div class="text-3xl sm:text-4xl font-bold text-white">{s.value}</div>
            <div class="text-sm text-gray-400 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Fade-in al cargar (cero JS). */
  .hero-a-content {
    animation: hero-a-fade-in 0.8s ease-out both;
  }

  @keyframes hero-a-fade-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-a-content {
      animation: none;
    }
  }
</style>
