---

<section id="servicios" class="services-section py-24 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-4xl sm:text-5xl font-bold text-white mb-4 tracking-tight">
        Software a medida
      </h2>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        Cuando necesitás algo único, lo construimos. Estos son nuestros pilares técnicos.
      </p>
    </div>

    <ul class="services-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 list-none p-0">
      {services.map((service, i) => (
        <li class="service-card-wrapper" style={`--card-i: ${i}`}>
          <a
            href={service.href}
            class="service-card group relative block h-full p-6 rounded-2xl transition-all duration-300 overflow-hidden"
          >
            <div class="flex flex-col gap-4 h-full relative z-[5]">
              <div class="card-icon inline-flex items-center justify-center w-11 h-11 rounded-xl">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={ICONS[service.icon]}
                />
              </div>
              <h3 class="card-title text-xl font-semibold tracking-tight">{service.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{service.description}</p>
              <ul class="flex flex-wrap gap-1.5 list-none p-0 mt-auto">
                {service.chips.map((chip) => (
                  <li class="card-chip text-[11px] px-2 py-1">{chip}</li>
                ))}
              </ul>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Stagger fade-up al scroll. JS suma is-visible al entrar al viewport. */
  .service-card-wrapper {
    will-change: transform;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--card-i) * 80ms);
  }
  .service-card-wrapper.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Glass minimal + cursor-tracking inner glow.
     `contain: layout style` evita reflow en hermanos durante scroll/hover. */
  .service-card {
    contain: layout style;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset;
  }
  .service-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle at var(--mx, 50%) var(--my, 0%),
      rgba(168, 85, 247, 0.22),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .service-card:hover {
    transform: translateY(-4px);
    border-color: rgba(168, 85, 247, 0.35);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 12px 32px rgba(0, 0, 0, 0.35);
  }
  .service-card:hover::after {
    opacity: 1;
  }

  /* Icon: gradient violet→pink sólido con glow. */
  .card-icon {
    background: linear-gradient(135deg, rgb(168 85 247), rgb(236 72 153));
    color: white;
    box-shadow: 0 0 24px rgba(168, 85, 247, 0.3);
  }

  /* Title: blanco sólido. */
  .card-title {
    color: white;
  }

  /* Chips: pill blanco translúcido. */
  .card-chip {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card-wrapper {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .service-card,
    .service-card:hover {
      transform: none;
      transition: none;
    }
    .service-card::after {
      display: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

    // Stagger fade-up al scroll.
    const cards = document.querySelectorAll<HTMLElement>('.service-card-wrapper');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    cards.forEach((c) => io.observe(c));
    controller.signal.addEventListener('abort', () => io.disconnect(), { once: true });

    // Cursor tracking para el inner glow radial.
    const cursorCards = document.querySelectorAll<HTMLElement>('.service-card');
    cursorCards.forEach((card) => {
      card.addEventListener(
        'mousemove',
        (e) => {
          const rect = card.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          card.style.setProperty('--mx', `${x}%`);
          card.style.setProperty('--my', `${y}%`);
        },
        { signal: controller.signal },
      );
    });
  } else {
    document.querySelectorAll<HTMLElement>('.service-card-wrapper').forEach((c) => c.classList.add('is-visible'));
  }
</script>
