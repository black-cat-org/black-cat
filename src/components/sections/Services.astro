---
// Iconos Lucide outline (lucide.dev). Stroke 1.5, currentColor.
const ICONS: Record<string, string> = {
  'code-2':
    '<path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>',
  database:
    '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>',
  smartphone:
    '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  sparkles:
    '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
  'shopping-bag':
    '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  cloud: '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
  'bar-chart-3':
    '<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
  'life-buoy':
    '<circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/><circle cx="12" cy="12" r="4"/>',
};

const services = [
  {
    icon: 'code-2',
    title: 'Frontend',
    description: 'Sitios y aplicaciones rápidas, modernas y optimizadas para SEO.',
    chips: ['React', 'Next.js', 'Astro', 'TypeScript', 'Tailwind'],
    href: '/servicios/desarrollo-web',
  },
  {
    icon: 'database',
    title: 'Backend & Data',
    description: 'Sistemas robustos que escalan con tu producto. APIs, tiempo real, datos.',
    chips: ['NestJS', 'GraphQL', 'PostgreSQL', 'REST', 'Supabase', 'Firebase', 'MongoDB'],
    href: '/servicios/backend-apis',
  },
  {
    icon: 'smartphone',
    title: 'Mobile',
    description: 'Apps nativas y multiplataforma para iOS y Android.',
    chips: ['Swift', 'Kotlin', 'React Native', 'Flutter', 'Expo'],
    href: '/servicios/apps-moviles',
  },
  {
    icon: 'sparkles',
    title: 'IA & Automatización',
    description: 'Productos y procesos potenciados con IA. Agentes, chatbots, automatización.',
    chips: ['OpenAI', 'Claude', 'Gemini', 'RAG', 'Agentes'],
    href: '/servicios/ia',
  },
  {
    icon: 'shopping-bag',
    title: 'E-commerce',
    description: 'Tiendas online listas para vender. Pasarelas, suscripciones, catálogos.',
    chips: ['Shopify', 'WooCommerce', 'Stripe', 'Custom'],
    href: '/servicios/ecommerce',
  },
  {
    icon: 'cloud',
    title: 'Infraestructura & DevOps',
    description: 'Despliegue, escalado y observabilidad. Cloud que no se cae.',
    chips: ['AWS', 'Cloudflare', 'Vercel', 'Docker', 'Kubernetes'],
    href: '/servicios/infraestructura',
  },
  {
    icon: 'bar-chart-3',
    title: 'Analytics & Data',
    description: 'Dashboards y métricas que muestran lo que importa.',
    chips: ['PostHog', 'BigQuery', 'GA4', 'Dashboards'],
    href: '/servicios/analytics',
  },
  {
    icon: 'life-buoy',
    title: 'Soporte & Consultoría',
    description: 'Soporte continuo después del lanzamiento. Mantenimiento, cobros, ajustes.',
    chips: ['Suscripciones', 'Cobros & reembolsos', 'Mantenimiento', 'Soporte continuo'],
    href: '/servicios/soporte-tecnico',
  },
];

// Paleta rotada por celda (i % 3): gradiente de marca + glow radial + acentos a juego.
// Coherente con el hero. Los tokens --gradient-* viven en global.css.
const PALETTES = [
  {
    grad: 'var(--gradient-violet-rose)',
    glow: 'radial-gradient(120% 92% at 24% -6%, rgba(168,85,247,.22), rgba(244,114,182,.10) 38%, transparent 62%)',
    underlineGlow: '0 0 16px rgba(244,114,182,.55)',
    num: 'rgba(244,114,182,.82)',
    chipMoreBorder: 'rgba(244,114,182,.34)',
    chipMoreColor: 'rgba(249,168,212,.92)',
  },
  {
    grad: 'var(--gradient-violet-blue)',
    glow: 'radial-gradient(120% 92% at 24% -6%, rgba(139,124,255,.22), rgba(91,157,255,.10) 38%, transparent 62%)',
    underlineGlow: '0 0 16px rgba(91,157,255,.55)',
    num: 'rgba(147,170,255,.85)',
    chipMoreBorder: 'rgba(124,124,255,.34)',
    chipMoreColor: 'rgba(191,200,255,.92)',
  },
  {
    grad: 'var(--gradient-teal-blue)',
    glow: 'radial-gradient(120% 92% at 24% -6%, rgba(45,212,191,.22), rgba(56,189,248,.10) 38%, transparent 62%)',
    underlineGlow: '0 0 16px rgba(56,189,248,.55)',
    num: 'rgba(94,234,212,.85)',
    chipMoreBorder: 'rgba(45,212,191,.34)',
    chipMoreColor: 'rgba(153,246,228,.92)',
  },
];

const MAX_CHIPS = 4;
---

<!--
  Services "Software a medida" — grid aireado con hairlines (sin cards), título en gradiente
  del color de la celda + subrayado que se expande, glow radial al hover, e icono que pasa de
  tile monocromo (reposo) a anillo + halo gradiente (hover). 3 gradientes de marca rotados por
  celda. Render estático (sin JS): el hover/reveal es 100% CSS. Respeta prefers-reduced-motion.
-->
<section id="servicios" class="svc-section relative py-24 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 reveal">
      <span class="h-eyebrow"><span class="dot"></span> Qué hacemos</span>
      <h2 class="h-title mt-5 text-4xl sm:text-5xl">Software <span class="text-grad">a medida</span></h2>
      <p class="mt-4 text-lg text-white/55 max-w-2xl mx-auto">
        Cuando necesitás algo único, lo construimos. Estos son nuestros pilares técnicos.
      </p>
    </div>

    <ul class="svc-grid" role="list">
      {services.map((s, i) => {
        const p = PALETTES[i % PALETTES.length];
        const num = String(i + 1).padStart(2, '0');
        const shown = s.chips.slice(0, MAX_CHIPS);
        const extra = s.chips.length - shown.length;
        const styleVars =
          `--grad:${p.grad};--glow:${p.glow};--underline-glow:${p.underlineGlow};` +
          `--num-color:${p.num};--chip-more-border:${p.chipMoreBorder};--chip-more-color:${p.chipMoreColor};` +
          `--d:${120 + i * 70}ms;`;
        return (
          <li class="svc-cell" style={styleVars}>
            <a href={s.href} class="absolute inset-0 z-10" aria-label={`${s.title}: ${s.description}`}></a>
            <div class="flex items-center justify-between">
              <span class="svc-ic">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[s.icon]} />
              </span>
              <span class="svc-num">{num}</span>
            </div>
            <h3 class="svc-title mt-5">{s.title}</h3>
            <p class="svc-line">{s.description}</p>
            <div class="svc-chips" aria-hidden="true">
              {shown.map((c) => <span class="chip">{c}</span>)}
              {extra > 0 && <span class="chip chip-more">+{extra}</span>}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  /* Tokens + fuentes de la sección (no afectan al resto del sitio). --gradient-* viven en global.css. */
  .svc-section {
    font-family: 'Sora', system-ui, sans-serif;
    --bg: #09090b;
    --accent-violet: #8b5cf6;
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* ---- Heading helpers (coherentes con el hero) ---- */
  .h-eyebrow {
    display: inline-flex; align-items: center; gap: .5rem;
    border-radius: 9999px; padding: .375rem .875rem;
    background: rgba(139,92,246,.05); border: 1px solid rgba(139,92,246,.22);
    color: rgba(255,255,255,.78); font-size: 12.5px; font-weight: 500; letter-spacing: -.01em;
  }
  .h-eyebrow .dot { width: 6px; height: 6px; border-radius: 9999px; background: var(--accent-violet); }
  .h-title {
    font-family: 'Plus Jakarta Sans', 'Sora', system-ui, sans-serif;
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.05;
  }
  .text-grad {
    background: var(--gradient-violet-rose);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .chip {
    display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 9999px;
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
    color: rgba(255,255,255,.85);
  }

  /* ---- Motion sutil: focus-in en load (sin scroll) ---- */
  .reveal { opacity: 0; filter: blur(8px); animation: reveal-focus .8s var(--ease-out) forwards; }
  @keyframes reveal-focus { to { opacity: 1; filter: blur(0); } }

  /* ---- Grid aireado: hairlines internos por gap sobre capa fina (sin cards) ---- */
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 16px;
    overflow: hidden;
    list-style: none; margin: 0; padding: 0;
  }
  @media (max-width: 1024px) { .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px)  { .svc-grid { grid-template-columns: 1fr; } }

  .svc-cell {
    position: relative;
    background: var(--bg);
    padding: 2rem 1.75rem;
    display: flex; flex-direction: column;
    min-height: 244px;
    isolation: isolate;
    transition: background .45s var(--ease-out);
  }
  /* Glow radial (color de la celda): off por defecto, se enciende en hover/focus. */
  .svc-cell::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: var(--glow, radial-gradient(120% 90% at 24% -6%, rgba(139,92,246,.18), transparent 60%));
    opacity: 0; transition: opacity .5s var(--ease-out);
  }
  .svc-cell:hover { background: rgba(255,255,255,.018); }
  .svc-cell:hover::before { opacity: 1; }

  /* ---- Icono: reposo tile monocromo; hover = anillo + halo gradiente (40px) ---- */
  .svc-ic {
    position: relative; isolation: isolate;
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 11px;
    color: rgba(255,255,255,.62);
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    transition: color .4s var(--ease-out), background .4s var(--ease-out),
                border-color .4s var(--ease-out), transform .4s var(--ease-out);
  }
  /* Anillo gradiente (mask): apagado en reposo. */
  .svc-ic::before {
    content: ""; position: absolute; inset: 0; border-radius: inherit; z-index: -1;
    padding: 1.5px;
    background: var(--grad, var(--gradient-violet-rose));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    opacity: 0;
    transition: opacity .4s var(--ease-out), padding .4s var(--ease-out), filter .4s var(--ease-out);
  }
  /* Halo/glow gradiente: apagado en reposo, crece al encender. */
  .svc-ic::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; z-index: -2;
    background: var(--grad, var(--gradient-violet-rose));
    opacity: 0; filter: blur(12px); transform: scale(.9);
    transition: opacity .5s var(--ease-out), transform .5s var(--ease-out), filter .5s var(--ease-out);
  }
  .svc-cell:hover .svc-ic,
  .svc-cell:focus-within .svc-ic {
    color: #fff; background: rgba(255,255,255,.05); border-color: transparent;
    transform: translateY(-1px);
  }
  .svc-cell:hover .svc-ic::before,
  .svc-cell:focus-within .svc-ic::before { opacity: 1; padding: 2px; filter: brightness(1.12); }
  .svc-cell:hover .svc-ic::after,
  .svc-cell:focus-within .svc-ic::after { opacity: .5; transform: scale(1.22); filter: blur(15px); }

  .svc-num {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px; font-weight: 500; letter-spacing: .04em;
    color: rgba(255,255,255,.30);
    transition: color .4s var(--ease-out);
  }
  .svc-cell:hover .svc-num,
  .svc-cell:focus-within .svc-num { color: var(--num-color, rgba(244,114,182,.78)); }

  /* Título en gradiente del color de la celda + subrayado que se expande. */
  .svc-title {
    position: relative; display: inline-block; align-self: flex-start;
    font-family: 'Plus Jakarta Sans', 'Sora', system-ui, sans-serif;
    font-weight: 700; letter-spacing: -.02em; line-height: 1.15; font-size: 1.0625rem;
    background: var(--grad, var(--gradient-violet-rose));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    filter: saturate(.92) brightness(.96);
    transition: filter .4s var(--ease-out);
  }
  .svc-cell:hover .svc-title,
  .svc-cell:focus-within .svc-title { filter: saturate(1.1) brightness(1.08); }
  .svc-title::after {
    content: ""; position: absolute; left: 0; bottom: -6px; height: 2px; width: 100%;
    background: var(--grad, var(--gradient-violet-rose)); border-radius: 2px;
    transform: scaleX(.34); transform-origin: left center; opacity: .8;
    transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out), opacity .4s var(--ease-out);
  }
  .svc-cell:hover .svc-title::after,
  .svc-cell:focus-within .svc-title::after {
    transform: scaleX(1); opacity: 1;
    box-shadow: var(--underline-glow, 0 0 16px rgba(139,92,246,.55));
  }

  .svc-line {
    margin-top: 1rem; font-size: .8125rem; line-height: 1.5;
    color: rgba(255,255,255,.45); transition: color .4s var(--ease-out);
  }
  .svc-cell:hover .svc-line,
  .svc-cell:focus-within .svc-line { color: rgba(255,255,255,.62); }

  /* Chips: aparecen desde abajo en hover/focus. */
  .svc-chips {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-top: auto; padding-top: 1rem;
    opacity: 0; transform: translateY(6px);
    transition: opacity .45s var(--ease-out), transform .45s var(--ease-out);
  }
  .svc-cell:hover .svc-chips,
  .svc-cell:focus-within .svc-chips { opacity: 1; transform: translateY(0); }
  .svc-chips .chip {
    font-size: 10.5px; padding: 2px 7px;
    background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.1);
    color: rgba(255,255,255,.74);
  }
  .svc-chips .chip-more {
    background: transparent;
    border-color: var(--chip-more-border, rgba(139,92,246,.3));
    color: var(--chip-more-color, rgba(196,181,253,.88));
  }

  .svc-cell:focus-within { background: rgba(255,255,255,.018); }
  .svc-cell:focus-within::before { opacity: 1; }
  .svc-cell a:focus-visible { outline: 2px solid var(--accent-violet); outline-offset: 4px; border-radius: 6px; }

  /* Load focus-in (sin scroll), escalonado por celda. */
  .svc-cell {
    opacity: 0; filter: blur(8px);
    animation: reveal-focus .7s var(--ease-out) forwards; animation-delay: var(--d, 0ms);
  }

  /* TOUCH / SIN HOVER: todo visible siempre (anillo/halo encendido, chips y descripción a la vista). */
  @media (hover: none), (pointer: coarse) {
    .svc-cell::before { opacity: .8; }
    .svc-cell .svc-ic { color: #fff; background: rgba(255,255,255,.05); border-color: transparent; }
    .svc-cell .svc-ic::before { opacity: 1; }
    .svc-cell .svc-ic::after { opacity: .34; transform: scale(1.12); }
    .svc-cell .svc-num { color: var(--num-color, rgba(244,114,182,.78)); }
    .svc-title::after { transform: scaleX(1); opacity: 1; box-shadow: var(--underline-glow, 0 0 16px rgba(139,92,246,.55)); }
    .svc-cell .svc-line { color: rgba(255,255,255,.62); }
    .svc-cell .svc-chips { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { animation: none; opacity: 1; filter: none; }
    .svc-cell, .svc-ic, .svc-ic::before, .svc-ic::after, .svc-chips, .svc-cell::before,
    .svc-title, .svc-title::after, .svc-line, .svc-num {
      animation: none !important; transition: none !important;
    }
    .svc-cell { opacity: 1; filter: none; }
    .svc-title::after { transform: scaleX(1); opacity: 1; }
  }
</style>
