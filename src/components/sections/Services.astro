const services = [
  {
    icon: 'code-2',
    title: 'Frontend',
    description: 'Sitios y aplicaciones rápidas, modernas y optimizadas para SEO.',
    chips: ['React', 'Next.js', 'Astro', 'TypeScript', 'Tailwind'],
    href: '/servicios/desarrollo-web',
  },
  {
    icon: 'database',
    title: 'Backend & Data',
    description: 'Sistemas robustos que escalan con tu producto. APIs, tiempo real, datos.',
    chips: ['NestJS', 'GraphQL', 'PostgreSQL', 'REST', 'Supabase', 'Firebase', 'MongoDB'],
    href: '/servicios/backend-apis',
  },
  {
    icon: 'smartphone',
    title: 'Mobile',
    description: 'Apps nativas y multiplataforma para iOS y Android.',
    chips: ['Swift', 'Kotlin', 'React Native', 'Flutter', 'Expo'],
    href: '/servicios/apps-moviles',
  },
  {
    icon: 'sparkles',
    title: 'IA & Automatización',
    description: 'Productos y procesos potenciados con IA. Agentes, chatbots, automatización.',
    chips: ['OpenAI', 'Claude', 'Gemini', 'RAG', 'Agentes'],
    href: '/servicios/ia',
  },
  {
    icon: 'shopping-bag',
    title: 'E-commerce',
    description: 'Tiendas online listas para vender. Pasarelas, suscripciones, catálogos.',
    chips: ['Shopify', 'WooCommerce', 'Stripe', 'Custom'],
    href: '/servicios/ecommerce',
  },
  {
    icon: 'cloud',
    title: 'Infraestructura & DevOps',
    description: 'Despliegue, escalado y observabilidad. Cloud que no se cae.',
    chips: ['AWS', 'Cloudflare', 'Vercel', 'Docker', 'Kubernetes'],
    href: '/servicios/infraestructura',
  },
  {
    icon: 'bar-chart-3',
    title: 'Analytics & Data',
    description: 'Dashboards y métricas que muestran lo que importa.',
    chips: ['PostHog', 'BigQuery', 'GA4', 'Dashboards'],
    href: '/servicios/analytics',
  },
  {
    icon: 'life-buoy',
    title: 'Soporte & Consultoría',
    description: 'Soporte continuo después del lanzamiento. Mantenimiento, cobros, ajustes.',
    chips: ['Suscripciones', 'Cobros & reembolsos', 'Mantenimiento', 'Soporte continuo'],
    href: '/servicios/soporte-tecnico',
  },
