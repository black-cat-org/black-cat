---
import { whatsappUrl } from '../../config/site';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16">
  <!-- Animated Background -->
  <div class="absolute inset-0 bg-linear-to-br from-purple-900/20 via-black to-blue-900/20">
    <div class="absolute inset-0 opacity-10"></div>
  </div>

  <!-- Floating Elements -->
  <div class="absolute top-20 left-10 w-72 h-72 bg-purple-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob"></div>
  <div class="absolute top-40 right-10 w-72 h-72 bg-blue-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000"></div>
  <div class="absolute bottom-20 left-1/2 w-72 h-72 bg-pink-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-20">
    <div class="space-y-8">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-600/10 border border-purple-600/20 rounded-full text-sm text-purple-400">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
        </span>
        Disponible para proyectos
      </div>

      <!-- Main Heading -->
      <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold">
        <span class="block text-white">Desarrollo Web</span>
        <span class="block bg-linear-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent">
          de Alto Impacto
        </span>
      </h1>

      <!-- Description -->
      <p class="max-w-2xl mx-auto text-lg sm:text-xl text-gray-400 leading-relaxed">
        Transformamos ideas en experiencias digitales rápidas, escalables y optimizadas.
        Especialistas en React, Astro, NestJS y tecnologías de vanguardia.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-4">
        <a
          href="/contacto"
          class="px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50 text-lg"
        >
          Comenzar Proyecto
        </a>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 border-2 border-purple-600 text-purple-400 hover:bg-purple-600 hover:text-white rounded-lg font-medium transition-all text-lg inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
          </svg>
          WhatsApp
        </a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-3 gap-8 max-w-2xl mx-auto pt-12">
        <div>
          <div class="text-3xl sm:text-4xl font-bold text-white">100+</div>
          <div class="text-sm text-gray-400 mt-1">Proyectos</div>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-bold text-white">98%</div>
          <div class="text-sm text-gray-400 mt-1">Satisfacción</div>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-bold text-white">24/7</div>
          <div class="text-sm text-gray-400 mt-1">Soporte</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
