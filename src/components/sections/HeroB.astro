---
import { whatsappUrl } from '../../config/site';
import { HERO_COPY } from './hero-shared';

// Split por palabras para text reveal con stagger.
const line1Words = HERO_COPY.title.line1.split(' ');
const line2Words = HERO_COPY.title.line2Gradient.split(' ');
const descWords = HERO_COPY.description.split(' ');
---

<!-- Hero B — Medio. Text reveal por palabra (CSS) + badge glow + underline en CTAs. ~2 KB extra (todo CSS). -->
<section class="relative min-h-dvh flex items-center justify-center overflow-hidden pt-16">
  <div class="absolute inset-0 bg-linear-to-br from-purple-900/20 via-black to-blue-900/20" aria-hidden="true"></div>
  <div class="absolute top-20 left-10 w-72 h-72 bg-purple-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob" aria-hidden="true"></div>
  <div class="absolute top-40 right-10 w-72 h-72 bg-blue-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000" aria-hidden="true"></div>
  <div class="absolute bottom-20 left-1/2 w-72 h-72 bg-pink-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-20">
    <div class="space-y-8">
      <!-- Badge con glow pulsante -->
      <div class="hero-b-badge inline-flex items-center gap-2 px-4 py-2 bg-purple-600/10 border border-purple-600/30 rounded-full text-sm text-purple-400">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
        </span>
        {HERO_COPY.badge}
      </div>

      <!-- Heading con text reveal por palabra -->
      <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold">
        <span class="block text-white">
          {line1Words.map((word, i) => (
            <span class="hero-b-word inline-block" style={`--word-i: ${i}`}>{word}{i < line1Words.length - 1 ? ' ' : ''}</span>
          ))}
        </span>
        <span class="block bg-linear-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent">
          {line2Words.map((word, i) => (
            <span class="hero-b-word inline-block" style={`--word-i: ${line1Words.length + i}`}>{word}{i < line2Words.length - 1 ? ' ' : ''}</span>
          ))}
        </span>
      </h1>

      <p class="max-w-2xl mx-auto text-lg sm:text-xl text-gray-400 leading-relaxed">
        {descWords.map((word, i) => (
          <span class="hero-b-word inline-block" style={`--word-i: ${line1Words.length + line2Words.length + i}`}>{word}{i < descWords.length - 1 ? ' ' : ''}</span>
        ))}
      </p>

      <div class="hero-b-ctas flex flex-col sm:flex-row gap-4 justify-center items-center pt-4">
        <a
          href={HERO_COPY.ctaPrimary.href}
          class="hero-b-cta-primary px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium shadow-lg shadow-purple-900/50 text-lg relative overflow-hidden"
        >
          <span class="relative z-10">{HERO_COPY.ctaPrimary.label}</span>
        </a>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="hero-b-cta-secondary px-8 py-4 border-2 border-purple-600 text-purple-400 hover:bg-purple-600 hover:text-white rounded-lg font-medium text-lg inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
          </svg>
          {HERO_COPY.ctaSecondary.label}
        </a>
      </div>

      <div class="hero-b-stats grid grid-cols-3 gap-8 max-w-2xl mx-auto pt-12">
        {HERO_COPY.stats.map((s) => (
          <div>
            <div class="text-3xl sm:text-4xl font-bold text-white">{s.value}</div>
            <div class="text-sm text-gray-400 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-b-word {
    opacity: 0;
    transform: translateY(0.4em);
    animation: hero-b-word-reveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--word-i) * 0.06s);
  }

  @keyframes hero-b-word-reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-b-badge {
    animation: hero-b-glow 2.4s ease-in-out infinite;
    box-shadow: 0 0 0 0 rgba(168, 85, 247, 0);
  }

  @keyframes hero-b-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(168, 85, 247, 0); }
    50% { box-shadow: 0 0 24px 4px rgba(168, 85, 247, 0.35); }
  }

  .hero-b-ctas, .hero-b-stats {
    opacity: 0;
    animation: hero-b-fade-up 0.8s 0.7s ease-out both;
  }

  @keyframes hero-b-fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-b-cta-primary::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: linear-gradient(90deg, #f472b6, #c084fc, #60a5fa);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-b-cta-primary:hover::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-b-word, .hero-b-ctas, .hero-b-stats {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .hero-b-badge { animation: none; }
    .hero-b-cta-primary::after { display: none; }
  }
</style>
