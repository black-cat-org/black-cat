---
import { whatsappUrl } from '../../config/site';
import { HERO_COPY } from './hero-shared';

const line1Words = HERO_COPY.title.line1.split(' ');
const descWords = HERO_COPY.description.split(' ');

// Parsea cada stat para detectar si es contable (número + sufijo simple) o texto fijo.
const stats = HERO_COPY.stats.map((s) => {
  const match = s.value.match(/^(\d+)([+%]?)$/);
  return match
    ? { label: s.label, target: parseInt(match[1], 10), suffix: match[2], animated: true as const }
    : { label: s.label, value: s.value, animated: false as const };
});
---

<!-- Hero Mix — base C + underline B en CTA primario + GSAP scrub sutil sin pin. -->
<section class="hero-mix-section relative min-h-dvh flex items-center justify-center overflow-hidden pt-16">
  <div class="absolute inset-0 bg-linear-to-br from-purple-900/20 via-zinc-950 to-blue-900/20" aria-hidden="true"></div>

  <div data-mix-blob data-speed="0.3" class="absolute top-20 left-10 w-72 h-72 bg-purple-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob will-change-transform" aria-hidden="true"></div>
  <div data-mix-blob data-speed="0.5" class="absolute top-40 right-10 w-72 h-72 bg-blue-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000 will-change-transform" aria-hidden="true"></div>
  <div data-mix-blob data-speed="0.2" class="absolute bottom-20 left-1/2 w-72 h-72 bg-pink-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000 will-change-transform" aria-hidden="true"></div>

  <div class="hero-mix-content relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-20">
    <div class="space-y-8">
      <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold">
        <span class="block text-white">
          {line1Words.map((word, i) => (
            <span class="hero-mix-word inline-block mr-[0.25em] last:mr-0" style={`--word-i: ${i}`}>{word}</span>
          ))}
        </span>
        <span class="hero-mix-line2 block bg-linear-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent" style={`--line1-count: ${line1Words.length}`}>
          {HERO_COPY.title.line2Gradient}
        </span>
      </h1>

      <p class="max-w-2xl mx-auto text-lg sm:text-xl text-gray-400 leading-relaxed">
        {descWords.map((word, i) => (
          <span class="hero-mix-word inline-block mr-[0.3em] last:mr-0" style={`--word-i: ${line1Words.length + 1 + i}`}>{word}</span>
        ))}
      </p>

      <div class="hero-mix-ctas flex flex-col sm:flex-row gap-4 justify-center items-center pt-4">
        <a
          href={HERO_COPY.ctaPrimary.href}
          class="hero-mix-cta-primary inline-flex items-center justify-center min-w-[16rem] px-8 py-4 text-white rounded-lg font-medium text-lg relative overflow-hidden"
        >
          <span class="relative z-10">{HERO_COPY.ctaPrimary.label}</span>
        </a>
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="hero-mix-cta-secondary inline-flex items-center justify-center gap-2 min-w-[16rem] px-8 py-4 border-2 rounded-lg font-medium text-lg"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
          </svg>
          {HERO_COPY.ctaSecondary.label}
        </a>
      </div>

      <div class="grid grid-cols-3 gap-8 max-w-2xl mx-auto pt-12">
        {stats.map((s, i) => (
          <div class="hero-mix-stat" style={`--stat-i: ${i}`}>
            {s.animated ? (
              <div class="hero-mix-counter text-3xl sm:text-4xl font-bold text-white tabular-nums inline-flex items-baseline justify-center">
                {String(s.target).split('').map((digit, di) => (
                  <span class="hero-mix-roller">
                    <span class="hero-mix-roller-track" style={`--digit: ${digit}; --d-i: ${di};`}>
                      {Array.from({ length: 30 }, (_, n) => <span>{n % 10}</span>)}
                    </span>
                  </span>
                ))}
                {s.suffix && <span>{s.suffix}</span>}
              </div>
            ) : (
              <div class="text-3xl sm:text-4xl font-bold text-white">{s.value}</div>
            )}
            <div class="text-sm text-gray-400 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Reveal por palabra (línea 1 + subcopy). */
  .hero-mix-word {
    opacity: 0;
    transform: translateY(0.4em);
    animation: hero-mix-word-reveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--word-i) * 0.06s);
  }

  @keyframes hero-mix-word-reveal {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Línea 2 (gradient) entera — no se splitea para preservar bg-clip-text. */
  .hero-mix-line2 {
    opacity: 0;
    transform: translateY(0.4em);
    animation: hero-mix-line2-reveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--line1-count) * 0.06s + 0.1s);
  }

  @keyframes hero-mix-line2-reveal {
    to { opacity: 1; transform: translateY(0); }
  }

  /* CTAs: solo fade, sin slide. */
  .hero-mix-ctas {
    opacity: 0;
    animation: hero-mix-fade 0.8s 0.7s ease-out both;
  }

  @keyframes hero-mix-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* CTA primario: gradiente diagonal violet → purple. Hover sutil con brightness y glow. */
  .hero-mix-cta-primary {
    background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 55%, #6d28d9 100%);
    box-shadow: 0 4px 24px rgba(139, 92, 246, 0.4);
    transition: filter 0.6s ease, box-shadow 0.6s ease;
  }
  .hero-mix-cta-primary:hover {
    filter: brightness(1.1);
    box-shadow: 0 6px 36px rgba(139, 92, 246, 0.55);
  }

  /* CTA secundario: mismos tonos del primario. Hover replica el del primario sin fill (solo brightness + glow). */
  .hero-mix-cta-secondary {
    border-color: #8b5cf6;
    color: #a78bfa;
    transition: filter 0.6s ease, box-shadow 0.6s ease;
  }
  .hero-mix-cta-secondary:hover {
    filter: brightness(1.1);
    box-shadow: 0 6px 36px rgba(139, 92, 246, 0.45);
  }

  .hero-mix-stat {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s ease-out, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--stat-i) * 0.12s);
  }
  .hero-mix-stat.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Rolling digit counter (slot-machine). Cada track contiene 30 dígitos
     (3 ciclos de 0-9). El target hace 2 vueltas completas + aterriza en
     el dígito final, así incluso los dígitos cuyo target es 0 se ven girar. */
  .hero-mix-roller {
    display: inline-block;
    height: 1em;
    overflow: hidden;
    line-height: 1;
    vertical-align: baseline;
  }
  .hero-mix-roller-track {
    display: flex;
    flex-direction: column;
    transform: translateY(0);
    transition: transform 2.2s cubic-bezier(0.16, 1, 0.3, 1);
    /* Stagger: cada dígito posterior arranca un poco después → cascada. */
    transition-delay: calc(var(--d-i) * 0.15s);
    --turns: 2;
  }
  .hero-mix-roller-track.is-rolling {
    transform: translateY(calc((var(--turns) * 10 + var(--digit)) * -1em));
  }
  .hero-mix-roller-track > span {
    display: block;
    height: 1em;
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mix-word,
    .hero-mix-line2,
    .hero-mix-ctas,
    .hero-mix-stat {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
    .hero-mix-roller-track {
      transition: none;
      transform: translateY(calc((var(--turns) * 10 + var(--digit)) * -1em));
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    gsap.registerPlugin(ScrollTrigger);

    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

    // Smooth scroll global con Lenis. Sincronizado con GSAP ticker.
    const lenis = new Lenis({
      duration: 1.2,
      smoothWheel: true,
    });
    lenis.on('scroll', ScrollTrigger.update);
    const tickerCb = (time: number) => lenis.raf(time * 1000);
    gsap.ticker.add(tickerCb);
    gsap.ticker.lagSmoothing(0);

    controller.signal.addEventListener('abort', () => {
      ScrollTrigger.getAll().forEach((t) => t.kill());
      gsap.ticker.remove(tickerCb);
      lenis.destroy();
    }, { once: true });

    const section = document.querySelector('.hero-mix-section');

    if (section) {
      // 1) Contenido del Hero se aleja con scrub. Más drama que antes pero
      //    termina pronto (bottom 50%) — no requiere mucho scroll.
      gsap.to('.hero-mix-content', {
        opacity: 0.15,
        y: -120,
        scale: 0.94,
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: 'bottom 50%',
          scrub: 0.5,
        },
      });

      // 2) Blobs con parallax amplio + scale dramático.
      gsap.utils.toArray<HTMLElement>('[data-mix-blob]').forEach((el) => {
        const speed = parseFloat(el.dataset.speed || '0.3');
        gsap.to(el, {
          y: () => window.innerHeight * speed * 1.4,
          scale: 1.4,
          opacity: 0.05,
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: 'bottom top',
            scrub: 0.6,
          },
        });
      });
    }

    // 3) Stats fade-up + rolling digit al entrar al viewport (CSS-driven).
    const statEls = document.querySelectorAll<HTMLElement>('.hero-mix-stat');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          // Activar rolling: cada track .hero-mix-roller-track suma is-rolling, CSS hace transform.
          entry.target.querySelectorAll('.hero-mix-roller-track').forEach((track) => {
            track.classList.add('is-rolling');
          });
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });
    statEls.forEach((s) => io.observe(s));
    controller.signal.addEventListener('abort', () => io.disconnect(), { once: true });
  } else {
    // Reduced motion: dejar los stats visibles con su valor final ya posicionado.
    document.querySelectorAll<HTMLElement>('.hero-mix-stat').forEach((s) => s.classList.add('is-visible'));
  }
</script>
