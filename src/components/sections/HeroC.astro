---
import { whatsappUrl } from '../../config/site';
import { HERO_COPY } from './hero-shared';

const line1Words = HERO_COPY.title.line1.split(' ');
const line2Words = HERO_COPY.title.line2Gradient.split(' ');
const descWords = HERO_COPY.description.split(' ');
---

<!-- Hero C — Alto. B + parallax JS + magnetic CTAs + stats fade-up on intersection. ~5 KB JS vanilla. -->
<section class="relative min-h-dvh flex items-center justify-center overflow-hidden pt-16" data-hero-c>
  <div class="absolute inset-0 bg-linear-to-br from-purple-900/20 via-black to-blue-900/20" aria-hidden="true"></div>

  <!-- Blobs con parallax (data-parallax data-speed) -->
  <div data-parallax data-speed="0.3" class="absolute top-20 left-10 w-72 h-72 bg-purple-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob will-change-transform" aria-hidden="true"></div>
  <div data-parallax data-speed="0.5" class="absolute top-40 right-10 w-72 h-72 bg-blue-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000 will-change-transform" aria-hidden="true"></div>
  <div data-parallax data-speed="0.2" class="absolute bottom-20 left-1/2 w-72 h-72 bg-pink-600 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000 will-change-transform" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-20">
    <div class="space-y-8">
      <div class="hero-c-badge inline-flex items-center gap-2 px-4 py-2 bg-purple-600/10 border border-purple-600/30 rounded-full text-sm text-purple-400">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
        </span>
        {HERO_COPY.badge}
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold">
        <span class="block text-white">
          {line1Words.map((word, i) => (
            <span class="hero-c-word inline-block" style={`--word-i: ${i}`}>{word}{i < line1Words.length - 1 ? ' ' : ''}</span>
          ))}
        </span>
        <span class="block bg-linear-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent">
          {line2Words.map((word, i) => (
            <span class="hero-c-word inline-block" style={`--word-i: ${line1Words.length + i}`}>{word}{i < line2Words.length - 1 ? ' ' : ''}</span>
          ))}
        </span>
      </h1>

      <p class="max-w-2xl mx-auto text-lg sm:text-xl text-gray-400 leading-relaxed">
        {descWords.map((word, i) => (
          <span class="hero-c-word inline-block" style={`--word-i: ${line1Words.length + line2Words.length + i}`}>{word}{i < descWords.length - 1 ? ' ' : ''}</span>
        ))}
      </p>

      <div class="hero-c-ctas flex flex-col sm:flex-row gap-4 justify-center items-center pt-4">
        <a
          data-magnetic
          href={HERO_COPY.ctaPrimary.href}
          class="px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium shadow-lg shadow-purple-900/50 text-lg will-change-transform"
        >
          {HERO_COPY.ctaPrimary.label}
        </a>
        <a
          data-magnetic
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 border-2 border-purple-600 text-purple-400 hover:bg-purple-600 hover:text-white rounded-lg font-medium text-lg inline-flex items-center gap-2 will-change-transform"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
          </svg>
          {HERO_COPY.ctaSecondary.label}
        </a>
      </div>

      <div class="grid grid-cols-3 gap-8 max-w-2xl mx-auto pt-12">
        {HERO_COPY.stats.map((s, i) => (
          <div class="hero-c-stat" style={`--stat-i: ${i}`}>
            <div class="text-3xl sm:text-4xl font-bold text-white">{s.value}</div>
            <div class="text-sm text-gray-400 mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-c-word {
    opacity: 0;
    transform: translateY(0.4em);
    animation: hero-c-word-reveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--word-i) * 0.06s);
  }

  @keyframes hero-c-word-reveal {
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-c-badge {
    animation: hero-c-glow 2.4s ease-in-out infinite;
  }
  @keyframes hero-c-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(168, 85, 247, 0); }
    50% { box-shadow: 0 0 24px 4px rgba(168, 85, 247, 0.35); }
  }

  .hero-c-ctas {
    opacity: 0;
    animation: hero-c-fade-up 0.8s 0.7s ease-out both;
  }
  @keyframes hero-c-fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-c-stat {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s ease-out, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--stat-i) * 0.12s);
  }
  .hero-c-stat.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-c-word, .hero-c-ctas, .hero-c-stat {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
    .hero-c-badge { animation: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    // AbortController + astro:before-swap para limpieza ante view transitions futuras.
    const controller = new AbortController();
    const { signal } = controller;
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

    // 1) Parallax suave en blobs (RAF + scroll).
    const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');
    let ticking = false;

    const updateParallax = () => {
      const y = window.scrollY;
      parallaxEls.forEach((el) => {
        const speed = parseFloat(el.dataset.speed || '0.3');
        el.style.transform = `translate3d(0, ${y * speed}px, 0)`;
      });
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }, { passive: true, signal });

    // 2) Magnetic hover en CTAs (mousemove con max-distance).
    const magneticEls = document.querySelectorAll<HTMLElement>('[data-magnetic]');
    const MAX_DISTANCE = 14;

    magneticEls.forEach((el) => {
      el.addEventListener('mousemove', (e) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        const dx = Math.max(-MAX_DISTANCE, Math.min(MAX_DISTANCE, x * 0.25));
        const dy = Math.max(-MAX_DISTANCE, Math.min(MAX_DISTANCE, y * 0.25));
        el.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
      }, { signal });
      el.addEventListener('mouseleave', () => {
        el.style.transform = 'translate3d(0, 0, 0)';
      }, { signal });
    });

    // 3) Stats fade-up al entrar al viewport.
    const stats = document.querySelectorAll('.hero-c-stat');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    stats.forEach((s) => io.observe(s));
    signal.addEventListener('abort', () => io.disconnect(), { once: true });
  } else {
    // Sin animación: dejar todo visible.
    document.querySelectorAll('.hero-c-stat').forEach((s) => s.classList.add('is-visible'));
  }
</script>
