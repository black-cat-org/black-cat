---
// Botón / CTA reutilizable. Renderiza <a> si recibe href, <button> en caso contrario.
// Usa el token rounded-btn (definido en src/styles/global.css → @theme).
//
// Variants:
//   - primary  (default): púrpura sólido con shadow
//   - secondary         : outline púrpura, hover llena
//   - chip              : gris oscuro chico (filtros, tags clickeables)
//
// Sizes:
//   - md (default): px-4 py-2 text-sm
//   - lg          : px-8 py-4 (texto base)
//   - xl          : px-8 py-4 text-lg (CTAs hero / page-level)

interface Props {
  variant?: 'primary' | 'secondary' | 'chip';
  size?: 'md' | 'lg' | 'xl';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: string;
  rel?: string;
  class?: string;
  'aria-label'?: string;
}

const {
  variant = 'primary',
  size = 'lg',
  href,
  type = 'button',
  target,
  rel,
  class: extra = '',
  'aria-label': ariaLabel,
} = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 font-medium transition-all rounded-btn';

const sizeMap: Record<string, string> = {
  md: 'px-4 py-2 text-sm',
  lg: 'px-8 py-4',
  xl: 'px-8 py-4 text-lg',
};

const variantMap: Record<string, string> = {
  primary: 'bg-purple-600 hover:bg-purple-700 text-white shadow-lg shadow-purple-900/50',
  secondary: 'border-2 border-purple-600 text-purple-400 hover:bg-purple-600 hover:text-white',
  chip: 'bg-gray-800 hover:bg-purple-600 text-gray-300 hover:text-white text-sm',
};

const className = [base, sizeMap[size], variantMap[variant], extra].filter(Boolean).join(' ');

// Auto-rel para links externos.
const computedRel =
  rel ?? (href && /^https?:\/\//.test(href) && target === '_blank' ? 'noopener noreferrer' : undefined);
---

{href ? (
  <a href={href} class={className} target={target} rel={computedRel} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class={className} aria-label={ariaLabel}>
    <slot />
  </button>
)}
