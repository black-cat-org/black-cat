---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout
  title="¡Gracias! - Black Cat"
  description="Gracias por contactarnos. Te responderemos pronto."
>
  <Navigation />

  <section class="min-h-screen flex items-center justify-center px-4 bg-gradient-to-b from-black via-gray-900 to-black">
    <div class="max-w-2xl text-center">
      <!-- Success Icon -->
      <div class="mb-8">
        <div class="w-24 h-24 bg-gradient-to-br from-purple-600 to-pink-600 rounded-full flex items-center justify-center mx-auto">
          <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </div>

      <!-- Message -->
      <h1 class="text-5xl sm:text-6xl font-bold text-white mb-6">
        ¡Mensaje enviado!
      </h1>
      <p class="text-xl text-gray-400 mb-8 leading-relaxed">
        Gracias por contactarnos. Hemos recibido tu mensaje y te responderemos en menos de 24 horas hábiles.
      </p>

      <!-- Next Steps -->
      <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8 mb-8 text-left">
        <h2 class="text-xl font-bold text-white mb-4">¿Qué sigue?</h2>
        <ul class="space-y-3 text-gray-400">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-purple-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Revisaremos tu consulta en detalle</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-purple-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Te contactaremos para agendar una consultoría gratuita</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-purple-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Recibirás un presupuesto personalizado</span>
          </li>
        </ul>
      </div>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="px-8 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50"
        >
          Volver al inicio
        </a>
        <a
          href="/portfolio"
          class="px-8 py-3 border-2 border-purple-600 text-purple-400 hover:bg-purple-600 hover:text-white rounded-lg font-medium transition-all"
        >
          Ver proyectos
        </a>
      </div>

      <!-- Emergency Contact -->
      <div class="mt-12 text-gray-400">
        <p class="mb-4">¿Necesitas una respuesta más rápida?</p>
        <a
          href="https://wa.me/5491234567890"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-purple-400 hover:text-purple-300 font-semibold"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Escríbenos por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Auto redirect after 10 seconds
  setTimeout(() => {
    window.location.href = '/';
  }, 10000);
</script>
