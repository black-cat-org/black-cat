---
import { Icon } from 'astro-icon/components';
import Navigation from '../components/Navigation.tsx';
import Footer from '../components/sections/Footer.astro';
import Layout from '../layouts/Layout.astro';

// Desglose de servicios — concepto "Dos tonos" (portado de design-explorations/sv-03b).
// 8 áreas detalladas: short (one-liner), full (párrafo), tech (stack), features (8 c/u).
const services = [
  {
    icon: 'code-2', title: 'Frontend', href: '/servicios/desarrollo-web',
    short: 'Sitios y aplicaciones rápidas, modernas y optimizadas para SEO.',
    full: 'Construimos interfaces de alto rendimiento con las tecnologías líderes del frontend moderno. Cada pantalla está pensada para cargar al instante, verse impecable en cualquier dispositivo y posicionar en buscadores. Desde landing pages hasta aplicaciones complejas con estado en tiempo real.',
    tech: ['React', 'Next.js', 'Astro', 'TypeScript', 'Tailwind', 'Vue'],
    features: [
      'Single Page Applications (SPA) y arquitecturas a componentes',
      'Server-Side Rendering (SSR) y Static Generation (SSG)',
      'Progressive Web Apps (PWA) instalables y offline',
      'Optimización de Core Web Vitals y SEO técnico',
      'Animaciones y microinteracciones fluidas',
      'Design systems y componentes reutilizables',
      'Accesibilidad (WCAG) desde el diseño',
      'Testing automatizado e integración continua',
    ],
  },
  {
    icon: 'database', title: 'Backend & Data', href: '/servicios/backend-apis',
    short: 'Sistemas robustos que escalan con tu producto. APIs, tiempo real, datos.',
    full: 'Diseñamos arquitecturas backend sólidas, seguras y preparadas para crecer. APIs REST o GraphQL, lógica de negocio, autenticación, tiempo real y modelado de datos sobre bases SQL y NoSQL. Construido para soportar tráfico real sin sorpresas ni cuellos de botella.',
    tech: ['NestJS', 'GraphQL', 'PostgreSQL', 'REST', 'Supabase', 'Firebase', 'MongoDB'],
    features: [
      'APIs REST y GraphQL documentadas (Swagger)',
      'Microservicios o monolito modular según el caso',
      'Autenticación y autorización (JWT, OAuth, roles)',
      'Bases de datos SQL y NoSQL modeladas a tu dominio',
      'Tiempo real con WebSockets y suscripciones',
      'Cache y colas con Redis para performance',
      'Migraciones, seeds y backups automáticos',
      'Testing unitario e integración',
    ],
  },
  {
    icon: 'smartphone', title: 'Mobile', href: '/servicios/apps-moviles',
    short: 'Apps nativas y multiplataforma para iOS y Android.',
    full: 'Llevamos tu producto al bolsillo de tus usuarios con apps fluidas y de aspecto nativo. Desarrollamos multiplataforma con Flutter o React Native, o nativo con Swift y Kotlin cuando el caso lo pide. Publicación en stores, integraciones y soporte incluidos.',
    tech: ['Flutter', 'React Native', 'Swift', 'Kotlin', 'Expo', 'Firebase'],
    features: [
