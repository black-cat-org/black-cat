// Iconos-anillo (Lucide). Inline porque no está instalado @iconify-json/lucide.
const RING_ICONS: Record<string, string> = {
  'code-2':       '<path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>',
  'database':     '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>',
  'smartphone':   '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  'sparkles':     '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
  'shopping-bag': '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  'cloud':        '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
  'bar-chart-3':  '<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
  'life-buoy':    '<circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/><circle cx="12" cy="12" r="4"/>',
};

// Stack: [slug simple-icons, color de marca]. Colores tomados de TrustSection (home).
// Sólo entradas con logo real; los ítems sin marca (REST, RAG, Agentes, Custom) se omiten.
const TECHS: Record<string, [string, string]> = {
  'React': ['react', '#61DAFB'], 'Next.js': ['nextdotjs', '#FFFFFF'], 'Astro': ['astro', '#BC52EE'],
  'TypeScript': ['typescript', '#3178C6'], 'Tailwind': ['tailwindcss', '#06B6D4'], 'Vue': ['vuedotjs', '#4FC08D'],
  'NestJS': ['nestjs', '#E0234E'], 'GraphQL': ['graphql', '#E10098'], 'PostgreSQL': ['postgresql', '#4169E1'],
  'Supabase': ['supabase', '#3FCF8E'], 'Firebase': ['firebase', '#FFCA28'], 'MongoDB': ['mongodb', '#47A248'],
  'Flutter': ['flutter', '#5DADE2'], 'React Native': ['react', '#61DAFB'], 'Swift': ['swift', '#F05138'],
  'Kotlin': ['kotlin', '#7F52FF'], 'Expo': ['expo', '#FFFFFF'], 'OpenAI': ['openai', '#FFFFFF'],
  'Claude': ['claude', '#D97757'], 'Gemini': ['googlegemini', '#8E75B2'], 'LangChain': ['langchain', '#FFFFFF'],
  'Shopify': ['shopify', '#7AB55C'], 'WooCommerce': ['woocommerce', '#96588A'], 'Stripe': ['stripe', '#635BFF'],
  'MercadoPago': ['mercadopago', '#00B1EA'], 'AWS': ['amazonwebservices', '#FF9900'], 'Cloudflare': ['cloudflare', '#F38020'],
  'Vercel': ['vercel', '#FFFFFF'], 'Docker': ['docker', '#2496ED'], 'Kubernetes': ['kubernetes', '#326CE5'],
  'Terraform': ['terraform', '#7B42BC'], 'PostHog': ['posthog', '#F54E00'], 'BigQuery': ['googlebigquery', '#669DF6'],
  'GA4': ['googleanalytics', '#E37400'], 'Metabase': ['metabase', '#509EE3'], 'Looker': ['looker', '#4285F4'],
  'Mixpanel': ['mixpanel', '#7856FF'], 'Snowflake': ['snowflake', '#29B5E8'], 'Sentry': ['sentry', '#8C5393'],
  'Grafana': ['grafana', '#F46800'], 'Prometheus': ['prometheus', '#E6522C'], 'Datadog': ['datadog', '#632CA6'],
  'PagerDuty': ['pagerduty', '#06AC38'],
};

// Sigla de categoría por servicio (marca gigante y tenue al lado del icono).
const MARKS: Record<string, string> = {
  'Frontend': 'UI',
  'Backend & Data': 'API',
  'Mobile': 'APP',
  'IA & Automatización': 'AI',
  'E-commerce': 'STORE',
  'Infraestructura & DevOps': 'CLOUD',
  'Analytics & Data': 'DATA',
  'Soporte & Consultoría': '24/7',
};

// Gradiente / tono / wash rotados por servicio (i % 3). --gradient-* viven en global.css.
const GRADS = ['var(--gradient-violet-rose)', 'var(--gradient-violet-blue)', 'var(--gradient-teal-blue)'];
const TONES = ['#f472b6', '#8b7cff', '#2dd4bf'];
const WASH = [
  ['rgba(139,92,246,.22)', 'rgba(244,114,182,.17)'],
  ['rgba(167,139,250,.20)', 'rgba(91,157,255,.17)'],
  ['rgba(45,212,191,.19)', 'rgba(56,189,248,.17)'],
];
---

<Layout
  title="Servicios"
  description="Ocho áreas, un mismo estándar: frontend, backend, apps móviles, IA, e-commerce, infraestructura, analytics y soporte. Software a medida de principio a fin."
>
  <Navigation client:load currentPath={Astro.url.pathname} />

  <!-- Desglose de servicios — "Dos tonos" -->
  <section id="servicios" class="sv-section relative pt-32 pb-10 px-4 sm:px-6 lg:px-8 overflow-x-clip">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12 reveal">
        <h1 class="h-title text-4xl sm:text-6xl">Software <span class="text-grad">a medida</span></h1>
        <p class="mt-5 text-lg text-white/55 max-w-2xl mx-auto">
          Ocho áreas, un mismo estándar. Del frontend al soporte, construimos lo que tu producto necesita.
        </p>
      </div>

      {services.map((s, i) => {
        const g = i % 3;
        const grad = GRADS[g];
        const tone = TONES[g];
        const wash1 = WASH[g][0];
        const wash2 = WASH[g][1];
        const washLeft = i % 2 === 0;
        const washDir = washLeft ? '90deg' : '270deg';
        const washX = washLeft ? '8%' : '92%';
        const rowStyle = `--grad:${grad}; --tone:${tone}; --wash1:${wash1}; --wash2:${wash2}; --d:${i * 70}ms`;
        const stack = s.tech.filter((t) => TECHS[t]);
        const slug = s.href.split('/').pop();
        return (
          <div id={slug} class="ds-row grid grid-cols-1 lg:grid-cols-2 gap-y-12 lg:gap-x-16 py-16 lg:py-20 scroll-mt-24 reveal" style={rowStyle}>
            {/* Zona TINTADA: icono + sigla + título + párrafo + stack */}
            <div class={washLeft ? 'lg:order-1' : 'lg:order-2'}>
              <div class="ds-wash relative px-2 sm:px-7 lg:px-10 py-1" style={`--washdir:${washDir}; --washx:${washX};`}>
                <div class="relative flex items-center gap-5">
                  <div class="ds-iconring flex items-center justify-center w-12 h-12 rounded-full" style="background: rgba(255,255,255,.025);">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style={`color:${tone}`} set:html={RING_ICONS[s.icon]} />
                  </div>
                  <span class="ds-mark text-4xl sm:text-5xl whitespace-nowrap select-none" style="color: rgba(255,255,255,.08)">{MARKS[s.title]}</span>
                </div>

                <h2 class="h-title mt-6 text-3xl sm:text-4xl text-white">{s.title}</h2>
                <p class="mt-3 text-[15px] font-medium" style={`color:${tone}`}>{s.short}</p>
                <p class="mt-5 text-[15.5px] leading-relaxed text-white/70 max-w-[46ch]">{s.full}</p>

                <div class="mt-7">
                  <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-white/35">Stack</p>
                  <div class="mt-4 tstack-row">
                    {stack.map((t) => (
                      <span class="tlogo" title={t} style={`--brand:${TECHS[t][1]}`}>
                        <Icon name={`simple-icons:${TECHS[t][0]}`} class="tlogo-ico" aria-hidden="true" />
                        <span class="tlogo-name">{t}</span>
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* Zona PLANA: qué incluye (8 features con marca de línea de gradiente) */}
            <div class={washLeft ? 'lg:order-2' : 'lg:order-1'}>
              <div class="relative px-2 sm:px-7 lg:px-10 py-1 lg:pt-2">
                <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-white/35">Qué incluye</p>
                <div class="mt-5">
                  {s.features.map((f) => (
                    <div class="ds-feat flex items-start gap-4 py-[13px]">
                      <span class="ds-dot"></span>
                      <span class="text-[14.5px] leading-snug text-white/65">{f}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ===== Sección Servicios — concepto "Dos tonos" (portado de sv-03b) ===== */
  .sv-section {
    font-family: 'Sora', system-ui, sans-serif;
  }

  .h-title {
    font-family: 'Plus Jakarta Sans', 'Sora', system-ui, sans-serif;
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.05;
  }
  .text-grad {
    background: var(--gradient-violet-rose);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }

  /* Entrada focus-in (sin scroll-reveals). */
  .reveal { opacity: 0; filter: blur(8px); animation: reveal-focus .8s var(--ease-out) forwards; animation-delay: var(--d, 0ms); }
  @keyframes reveal-focus { to { opacity: 1; filter: blur(0); } }

  .ds-row { position: relative; }

  /* Zona tintada: wash de gradiente que sangra hacia el fondo, sin borde ni caja. */
  .ds-wash { position: relative; isolation: isolate; }
  .ds-wash::before {
    content: ""; position: absolute; inset: -2.5rem -1.5rem; z-index: -1; pointer-events: none;
    -webkit-mask-image: linear-gradient(var(--washdir, 90deg), #000 0%, #000 50%, transparent 96%);
            mask-image: linear-gradient(var(--washdir, 90deg), #000 0%, #000 50%, transparent 96%);
    background:
      radial-gradient(125% 85% at var(--washx, 0%) 24%, var(--wash1) 0%, transparent 60%),
      radial-gradient(95% 75% at var(--washx, 0%) 98%, var(--wash2) 0%, transparent 58%);
  }

  /* Aro del icono: anillo de gradiente, sin relleno de caja. */
  .ds-iconring { position: relative; }
  .ds-iconring::after {
    content: ""; position: absolute; inset: 0; border-radius: 9999px;
    padding: 1.5px; background: var(--grad);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    opacity: .9;
  }

  /* Sigla de categoría detrás del icono. */
  .ds-mark { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; letter-spacing: -.04em; line-height: 1; }

  /* Stack: logos simple-icons coloreados por currentColor (mismo mecanismo que home>tecnologías):
     gris uniforme en reposo → color de marca al hover, con el nombre apareciendo debajo. */
  .tstack-row { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 2rem 1.9rem; }
  .tlogo { position: relative; width: 30px; height: 30px; display: block; }
  .tlogo-ico {
    width: 30px; height: 30px; display: block; fill: currentColor;
    color: rgba(255,255,255,.42);
    transition: color .4s var(--ease-out), transform .4s var(--ease-out);
  }
  .tlogo:hover .tlogo-ico { color: var(--brand); transform: translateY(-1px); }
  .tlogo-name {
    position: absolute; top: calc(100% + .6rem); left: 50%;
    transform: translateX(-50%) translateY(2px); white-space: nowrap;
    font-size: 11px; font-weight: 500; letter-spacing: .01em; color: rgba(255,255,255,.6);
    opacity: 0; pointer-events: none;
    transition: opacity .3s var(--ease-out), transform .3s var(--ease-out);
  }
  .tlogo:hover .tlogo-name { opacity: 1; transform: translateX(-50%) translateY(0); }

  /* Features: marca = línea corta de gradiente (sin dividers, sin hover). */
  .ds-feat { position: relative; }
  .ds-dot { flex: none; width: .85rem; height: 2px; margin-top: .62em; border-radius: 2px; background: var(--grad); opacity: .9; }

  @media (prefers-reduced-motion: reduce) {
    .reveal { animation: none; opacity: 1; filter: none; }
    .tlogo-ico, .tlogo-name { transition: none; }
  }
</style>
