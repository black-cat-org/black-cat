---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/sections/Footer.astro';
import { siteConfig, whatsappUrl } from '../config/site';

// Iconos Lucide outline.
const ICON_MAIL = '<path d="m4 7 8 5 8-5"/><rect x="3" y="5" width="18" height="14" rx="2"/>';
const ICON_PHONE = '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>';
const ICON_MAP = '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>';
const ICON_CLOCK = '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>';

const contactInfo = [
  {
    icon: ICON_MAIL,
    title: 'Email',
    value: siteConfig.contact.email,
    link: `mailto:${siteConfig.contact.email}`,
  },
  {
    icon: ICON_PHONE,
    title: 'WhatsApp',
    value: `+${siteConfig.contact.whatsapp.number}`,
    link: whatsappUrl(),
  },
  {
    icon: ICON_MAP,
    title: 'Ubicación',
    value: `${siteConfig.location.city}, ${siteConfig.location.country}`,
    link: null,
  },
  {
    icon: ICON_CLOCK,
    title: 'Horario',
    value: siteConfig.hours.label,
    link: null,
  },
];

const services = [
  'Desarrollo Web',
  'Backend & APIs',
  'Apps Móviles',
  'Diseño UI/UX',
  'E-commerce',
  'Infraestructura',
  'Hosting & SSL',
  'Soporte Técnico',
  'Consultoría',
  'Otro',
];

const formAction = `https://formsubmit.co/${siteConfig.contact.email}`;
---

<Layout
  title="Contacto"
  description="¿Tienes un proyecto en mente? Contáctanos para una consultoría gratuita. Email, WhatsApp o formulario de contacto."
>
  <Navigation />

  <!-- Hero Section -->
  <section class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-black via-gray-900 to-black">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-5xl sm:text-6xl font-bold text-white mb-6">
        Hablemos de tu <span class="bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">proyecto</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto">
        Agenda una consultoría gratuita. Respondemos en menos de 24 horas.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <div>
          <h2 class="text-3xl font-bold text-white mb-6">Envíanos un mensaje</h2>
          <form
            action={formAction}
            method="POST"
            class="space-y-6"
          >
            <!-- Honeypot anti-spam -->
            <input type="text" name="_honey" style="display:none">

            <!-- FormSubmit config: el primer envío real requiere validar el email destino con un click en el correo de confirmación que envía FormSubmit. -->
            <input type="hidden" name="_captcha" value="false">
            <input type="hidden" name="_template" value="table">
            <input type="hidden" name="_next" value={new URL(siteConfig.form.formsubmit.successRedirect, siteConfig.domain).toString()}>
            <input type="hidden" name="_subject" value={siteConfig.form.formsubmit.subjectLine}>

            <!-- Form Fields -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-300 mb-2">
                  Nombre completo *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 bg-gray-900 border border-gray-800 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all"
                  placeholder="Juan Pérez"
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
                  Email *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 bg-gray-900 border border-gray-800 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all"
                  placeholder="juan@empresa.com"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="phone" class="block text-sm font-medium text-gray-300 mb-2">
                  Teléfono
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full px-4 py-3 bg-gray-900 border border-gray-800 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all"
                  placeholder="+591 71234567"
                />
              </div>

              <div>
                <label for="company" class="block text-sm font-medium text-gray-300 mb-2">
                  Empresa
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  class="w-full px-4 py-3 bg-gray-900 border border-gray-800 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all"
                  placeholder="Mi Empresa"
                />
              </div>
            </div>

            <div>
              <label for="service" class="block text-sm font-medium text-gray-300 mb-2">
                Servicio de interés *
              </label>
              <select
                id="service"
                name="service"
                required
                class="w-full px-4 py-3 bg-gray-900 border border-gray-800 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all"
              >
                <option value="">Selecciona un servicio</option>
                {services.map((service) => (
                  <option value={service}>{service}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="budget" class="block text-sm font-medium text-gray-300 mb-2">
                Presupuesto estimado
              </label>
              <select
                id="budget"
                name="budget"
                class="w-full px-4 py-3 bg-gray-900 border border-gray-800 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all"
              >
                <option value="">Selecciona un rango</option>
                <option value="< $1,000">Menos de $1,000 USD</option>
                <option value="$1,000 - $2,500">$1,000 - $2,500 USD</option>
                <option value="$2,500 - $5,000">$2,500 - $5,000 USD</option>
                <option value="$5,000 - $10,000">$5,000 - $10,000 USD</option>
                <option value="> $10,000">Más de $10,000 USD</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-300 mb-2">
                Mensaje *
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="6"
                class="w-full px-4 py-3 bg-gray-900 border border-gray-800 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all resize-none"
                placeholder="Cuéntanos sobre tu proyecto, objetivos y timeline..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50 flex items-center justify-center gap-2"
            >
              Enviar Consulta
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>
        </div>

        <!-- Contact Info & Map -->
        <div class="space-y-8">
          <div>
            <h2 class="text-3xl font-bold text-white mb-6">Información de contacto</h2>
            <div class="space-y-4">
              {contactInfo.map((info) => (
                <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-purple-600 transition-all">
                  <div class="flex items-start gap-4">
                    <svg
                      class="w-7 h-7 text-purple-400 shrink-0 mt-1"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={info.icon}
                    />
                    <div class="flex-grow">
                      <div class="text-sm text-gray-400 mb-1">{info.title}</div>
                      {info.link ? (
                        <a
                          href={info.link}
                          target={info.link.startsWith('http') ? '_blank' : undefined}
                          rel={info.link.startsWith('http') ? 'noopener noreferrer' : undefined}
                          class="text-white font-semibold hover:text-purple-400 transition-colors break-all"
                        >
                          {info.value}
                        </a>
                      ) : (
                        <div class="text-white font-semibold">{info.value}</div>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Social Links -->
          <div class="bg-gradient-to-br from-purple-600 to-pink-600 rounded-2xl p-8 text-center">
            <h3 class="text-2xl font-bold text-white mb-4">¿Prefieres WhatsApp?</h3>
            <p class="text-purple-100 mb-6">
              Chatea con nosotros para una respuesta inmediata
            </p>
            <a
              href={whatsappUrl()}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-8 py-4 bg-white text-purple-600 hover:bg-gray-100 rounded-lg font-medium transition-all shadow-lg"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
              </svg>
              Abrir WhatsApp
            </a>
          </div>

          <!-- FAQ -->
          <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-white mb-4">Preguntas frecuentes</h3>
            <div class="space-y-4 text-sm">
              <div>
                <div class="text-purple-400 font-semibold mb-1">¿Cuánto demoran en responder?</div>
                <div class="text-gray-400">Respondemos en menos de 24 horas hábiles.</div>
              </div>
              <div>
                <div class="text-purple-400 font-semibold mb-1">¿La consultoría es gratuita?</div>
                <div class="text-gray-400">Sí, la primera consultoría es completamente gratis.</div>
              </div>
              <div>
                <div class="text-purple-400 font-semibold mb-1">¿Trabajan con clientes internacionales?</div>
                <div class="text-gray-400">Sí, trabajamos con clientes de todo el mundo.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
