---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/sections/Footer.astro';

const technologies = [
  { name: 'NestJS', level: 95 },
  { name: 'Node.js', level: 92 },
  { name: 'PostgreSQL', level: 90 },
  { name: 'MongoDB', level: 88 },
  { name: 'Redis', level: 85 },
  { name: 'GraphQL', level: 80 },
];

const features = [
  { icon: '🔄', title: 'APIs RESTful', description: 'APIs escalables con documentación Swagger automática' },
  { icon: '⚡', title: 'GraphQL', description: 'Consultas flexibles y eficientes con Apollo Server' },
  { icon: '🔐', title: 'Autenticación', description: 'JWT, OAuth2, Session-based y 2FA' },
  { icon: '📊', title: 'Bases de Datos', description: 'SQL, NoSQL y estrategias de cache óptimas' },
  { icon: '🚀', title: 'Microservicios', description: 'Arquitecturas distribuidas y escalables' },
  { icon: '📝', title: 'Documentación', description: 'Swagger UI, Postman collections y guías' },
];
---

<Layout title="Backend & APIs" description="Desarrollo de APIs REST y GraphQL con NestJS, Node.js y arquitecturas escalables.">
  <Navigation />

  <section class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black via-gray-900 to-black">
    <div class="max-w-7xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-600/10 border border-purple-600/20 rounded-full text-sm text-purple-400 mb-6">
        <span class="text-2xl">🚀</span>
        <span>Backend Profesional</span>
      </div>
      <h1 class="text-5xl sm:text-6xl font-bold text-white mb-6">
        Backend & <span class="bg-linear-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">APIs</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto mb-8">
        Arquitecturas robustas, APIs escalables y bases de datos optimizadas para soportar millones de peticiones.
      </p>
      <a href="/contacto" class="inline-flex items-center gap-2 px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50">
        Solicitar Presupuesto
      </a>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-12 text-center">Tecnologías</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        {technologies.map((tech) => (
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 text-center">
            <h3 class="text-lg font-bold text-white mb-3">{tech.name}</h3>
            <div class="w-full bg-gray-800 rounded-full h-2">
              <div class="bg-linear-to-r from-purple-600 to-pink-600 h-2 rounded-full" style={`width: ${tech.level}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black to-gray-900">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-12 text-center">Características</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {features.map((feature) => (
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-purple-600 transition-all">
            <div class="text-4xl mb-4">{feature.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2">{feature.title}</h3>
            <p class="text-gray-400">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold text-white mb-4">¿Necesitas una API robusta?</h2>
      <p class="text-xl text-gray-400 mb-8">Hablemos de tu arquitectura backend</p>
      <a href="/contacto" class="px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50 inline-block">
        Comenzar Proyecto
      </a>
    </div>
  </section>

  <Footer />
</Layout>
