---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/sections/Footer.astro';

const platforms = [
  { name: 'AWS', icon: '☁️', services: 'EC2, S3, Lambda, RDS, CloudFront' },
  { name: 'Vercel', icon: '▲', services: 'Edge Functions, Analytics, KV' },
  { name: 'Docker', icon: '🐳', services: 'Containerización y orquestación' },
  { name: 'Kubernetes', icon: '⚙️', services: 'Orquestación de contenedores' },
];

const features = [
  { icon: '🚀', title: 'CI/CD', description: 'Pipelines automáticos con GitHub Actions y GitLab CI' },
  { icon: '📊', title: 'Monitoreo', description: 'Logs, métricas y alertas 24/7' },
  { icon: '🔒', title: 'Seguridad', description: 'SSL, firewall, DDoS protection' },
  { icon: '⚡', title: 'Performance', description: 'CDN, cache y optimización continua' },
  { icon: '💾', title: 'Backups', description: 'Backups automáticos y disaster recovery' },
  { icon: '📈', title: 'Escalado', description: 'Auto-scaling horizontal y vertical' },
];
---

<Layout title="Infraestructura" description="Cloud infrastructure, DevOps, CI/CD y despliegue continuo en AWS, Vercel y más.">
  <Navigation />

  <section class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black via-gray-900 to-black">
    <div class="max-w-7xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-600/10 border border-purple-600/20 rounded-full text-sm text-purple-400 mb-6">
        <span class="text-2xl">☁️</span>
        <span>Cloud & DevOps</span>
      </div>
      <h1 class="text-5xl sm:text-6xl font-bold text-white mb-6">
        Infraestructura <span class="bg-linear-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">Cloud</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto mb-8">
        Configuración, despliegue y gestión de infraestructura escalable. DevOps profesional para máxima disponibilidad.
      </p>
      <a href="/contacto" class="inline-flex items-center gap-2 px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50">
        Solicitar Presupuesto
      </a>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-12 text-center">Plataformas Cloud</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {platforms.map((platform) => (
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-purple-600 transition-all">
            <div class="text-5xl mb-4 text-center">{platform.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2 text-center">{platform.name}</h3>
            <p class="text-gray-400 text-sm text-center">{platform.services}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black to-gray-900">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-12 text-center">Servicios DevOps</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {features.map((feature) => (
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-purple-600 transition-all">
            <div class="text-4xl mb-4">{feature.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2">{feature.title}</h3>
            <p class="text-gray-400">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold text-white mb-4">¿Necesitas infraestructura confiable?</h2>
      <p class="text-xl text-gray-400 mb-8">Configuremos tu cloud architecture</p>
      <a href="/contacto" class="px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50 inline-block">
        Comenzar Proyecto
      </a>
    </div>
  </section>

  <Footer />
</Layout>
