---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/sections/Footer.astro';

const plans = [
  {
    name: 'Básico',
    price: '$15/mes',
    features: ['5GB SSD', '50GB transferencia', 'SSL gratuito', '1 dominio', 'Soporte email'],
  },
  {
    name: 'Profesional',
    price: '$35/mes',
    features: ['20GB SSD', '200GB transferencia', 'SSL + CDN', '5 dominios', 'Backups diarios', 'Soporte prioritario'],
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    features: ['SSD ilimitado', 'Transferencia ilimitada', 'SSL + CDN premium', 'Dominios ilimitados', 'Backups horarios', 'Soporte 24/7'],
  },
];

const features = [
  { icon: '🔒', title: 'SSL Gratuito', description: 'Certificados Let\'s Encrypt renovación automática' },
  { icon: '⚡', title: 'CDN Global', description: 'Cloudflare para velocidad mundial' },
  { icon: '💾', title: 'Backups Automáticos', description: 'Diarios con retención de 30 días' },
  { icon: '📊', title: 'Monitoreo 24/7', description: 'Uptime monitoring y alertas' },
  { icon: '🛡️', title: 'DDoS Protection', description: 'Protección contra ataques' },
  { icon: '📈', title: '99.9% Uptime', description: 'SLA garantizado por contrato' },
];
---

<Layout title="Hosting & SSL - Black Cat" description="Hosting optimizado con SSL gratuito, CDN y monitoreo 24/7.">
  <Navigation />

  <section class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black via-gray-900 to-black">
    <div class="max-w-7xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-600/10 border border-purple-600/20 rounded-full text-sm text-purple-400 mb-6">
        <span class="text-2xl">🔒</span>
        <span>Hosting Seguro</span>
      </div>
      <h1 class="text-5xl sm:text-6xl font-bold text-white mb-6">
        Hosting & <span class="bg-linear-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">SSL</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto mb-8">
        Hosting rápido y seguro con SSL incluido. Tu sitio siempre online y protegido.
      </p>
      <a href="/contacto" class="inline-flex items-center gap-2 px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50">
        Ver Planes
      </a>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-12 text-center">Planes de Hosting</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {plans.map((plan) => (
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-purple-600 transition-all">
            <h3 class="text-2xl font-bold text-white mb-2">{plan.name}</h3>
            <div class="text-3xl font-bold text-purple-400 mb-6">{plan.price}</div>
            <ul class="space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-center gap-2 text-gray-300 text-sm">
                  <svg class="w-5 h-5 text-purple-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black to-gray-900">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-12 text-center">Incluido en Todos los Planes</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {features.map((feature) => (
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-purple-600 transition-all">
            <div class="text-4xl mb-4">{feature.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2">{feature.title}</h3>
            <p class="text-gray-400">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold text-white mb-4">¿Necesitas hosting confiable?</h2>
      <p class="text-xl text-gray-400 mb-8">Migración gratuita desde tu hosting actual</p>
      <a href="/contacto" class="px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50 inline-block">
        Contratar Hosting
      </a>
    </div>
  </section>

  <Footer />
</Layout>
