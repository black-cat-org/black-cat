---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.tsx';
import Footer from '../../components/sections/Footer.astro';

const platforms = [
  { name: 'iOS', icon: '🍎', description: 'Swift, SwiftUI, Objective-C' },
  { name: 'Android', icon: '🤖', description: 'Kotlin, Java, Jetpack Compose' },
  { name: 'Flutter', icon: '💙', description: 'Multiplataforma con Dart' },
  { name: 'React Native', icon: '⚛️', description: 'JavaScript/TypeScript cross-platform' },
];

const features = [
  { icon: '📱', title: 'Diseño Nativo', description: 'Material Design y Human Interface Guidelines' },
  { icon: '🔄', title: 'Sincronización', description: 'Datos en tiempo real con Firebase/Supabase' },
  { icon: '📲', title: 'Push Notifications', description: 'Notificaciones personalizadas multiplataforma' },
  { icon: '💳', title: 'Pagos In-App', description: 'IAP, Stripe, MercadoPago integrados' },
  { icon: '📍', title: 'Geolocalización', description: 'Maps, tracking y rutas optimizadas' },
  { icon: '🔒', title: 'Seguridad', description: 'Biometría, encriptación y almacenamiento seguro' },
];
---

<Layout title="Apps Móviles" description="Desarrollo de aplicaciones móviles iOS y Android con Flutter y React Native.">
  <Navigation client:load currentPath={Astro.url.pathname} />

  <section class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black via-gray-900 to-black">
    <div class="max-w-7xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-600/10 border border-purple-600/20 rounded-full text-sm text-purple-400 mb-6">
        <span class="text-2xl">📱</span>
        <span>Desarrollo Móvil</span>
      </div>
      <h1 class="text-5xl sm:text-6xl font-bold text-white mb-6">
        Aplicaciones <span class="bg-linear-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">Móviles</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto mb-8">
        Apps nativas y multiplataforma para iOS y Android. Experiencias fluidas que tus usuarios amarán.
      </p>
      <a href="/contacto" class="inline-flex items-center gap-2 px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-btn font-medium transition-all shadow-lg shadow-purple-900/50">
        Solicitar Presupuesto
      </a>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-12 text-center">Plataformas</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {platforms.map((platform) => (
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 text-center hover:border-purple-600 transition-all">
            <div class="text-5xl mb-4">{platform.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2">{platform.name}</h3>
            <p class="text-gray-400 text-sm">{platform.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black to-gray-900">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-12 text-center">Características</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {features.map((feature) => (
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-purple-600 transition-all">
            <div class="text-4xl mb-4">{feature.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2">{feature.title}</h3>
            <p class="text-gray-400">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold text-white mb-4">¿Lista tu app móvil?</h2>
      <p class="text-xl text-gray-400 mb-8">Transformemos tu idea en una app que funcione</p>
      <a href="/contacto" class="px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-btn font-medium transition-all shadow-lg shadow-purple-900/50 inline-block">
        Comenzar Proyecto
      </a>
    </div>
  </section>

  <Footer />
</Layout>
