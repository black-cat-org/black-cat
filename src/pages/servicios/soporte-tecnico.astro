---
import Navigation from '../../components/Navigation.tsx';
import Footer from '../../components/sections/Footer.astro';
import Layout from '../../layouts/Layout.astro';

const plans = [
  {
    name: 'Básico',
    price: '$200/mes',
    features: ['2 horas mensuales', 'Soporte por email', 'Response time 24h', 'Actualizaciones básicas', 'Reporte mensual'],
  },
  {
    name: 'Profesional',
    price: '$500/mes',
    features: ['8 horas mensuales', 'Soporte prioritario', 'Response time 4h', 'Nuevas features', 'Monitoreo 24/7', 'Reporte semanal'],
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    features: ['Horas ilimitadas', 'Soporte dedicado', 'Response time 1h', 'Desarrollo continuo', 'SLA garantizado', 'Reporte diario'],
  },
];

const services = [
  { icon: '🔧', title: 'Mantenimiento', description: 'Updates, parches de seguridad y optimización' },
  { icon: '🐛', title: 'Bug Fixes', description: 'Corrección rápida de errores y problemas' },
  { icon: '⚡', title: 'Performance', description: 'Análisis y mejora de velocidad' },
  { icon: '🔒', title: 'Seguridad', description: 'Auditorías y hardening continuo' },
  { icon: '📊', title: 'Monitoreo', description: 'Uptime, logs y alertas proactivas' },
  { icon: '🚀', title: 'Nuevas Features', description: 'Desarrollo de funcionalidades adicionales' },
];
---

<Layout title="Soporte Técnico" description="Mantenimiento y soporte continuo para tu aplicación web. Planes desde $200/mes.">
  <Navigation client:load currentPath={Astro.url.pathname} />

  <section class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black via-gray-900 to-black">
    <div class="max-w-7xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-purple-600/10 border border-purple-600/20 rounded-full text-sm text-purple-400 mb-6">
        <span class="text-2xl">🛠️</span>
        <span>Soporte Premium</span>
      </div>
      <h1 class="text-5xl sm:text-6xl font-bold text-white mb-6">
        Soporte <span class="bg-linear-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">Técnico</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto mb-8">
        Mantenimiento continuo, actualizaciones y nuevas features. Tu proyecto siempre actualizado y funcionando.
      </p>
      <a href="/contacto" class="inline-flex items-center gap-2 px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-btn font-medium transition-all shadow-lg shadow-purple-900/50">
        Ver Planes
      </a>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-12 text-center">Planes de Soporte</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {plans.map((plan, index) => (
          <div class={`bg-gray-900 border rounded-xl p-6 ${index === 1 ? 'border-purple-600 shadow-xl shadow-purple-900/20' : 'border-gray-800'} hover:border-purple-600 transition-all`}>
            {index === 1 && (
              <div class="text-center mb-4">
                <span class="inline-block px-3 py-1 bg-purple-600 text-white text-xs font-semibold rounded-full">
                  Más Popular
                </span>
              </div>
            )}
            <h3 class="text-2xl font-bold text-white mb-2">{plan.name}</h3>
            <div class="text-3xl font-bold text-purple-400 mb-6">{plan.price}</div>
            <ul class="space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-gray-300 text-sm">
                  <svg class="w-5 h-5 text-purple-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black to-gray-900">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-12 text-center">Servicios Incluidos</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-purple-600 transition-all">
            <div class="text-4xl mb-4">{service.icon}</div>
            <h3 class="text-xl font-bold text-white mb-2">{service.title}</h3>
            <p class="text-gray-400">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold text-white mb-4">¿Necesitas soporte continuo?</h2>
      <p class="text-xl text-gray-400 mb-8">Mantén tu proyecto siempre actualizado</p>
      <a href="/contacto" class="px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-btn font-medium transition-all shadow-lg shadow-purple-900/50 inline-block">
        Contratar Soporte
      </a>
    </div>
  </section>

  <Footer />
</Layout>
