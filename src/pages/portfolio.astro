---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/sections/Footer.astro';
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'E-commerce Premium',
    category: 'Tienda Virtual',
    description: 'Plataforma de comercio electrónico completa con integración de múltiples pasarelas de pago, gestión de inventario y panel administrativo avanzado.',
    challenge: 'Crear una experiencia de compra fluida con checkout en un solo paso y sistema de recomendaciones personalizado.',
    solution: 'Desarrollamos una SPA con Next.js y Stripe, implementando un sistema de cache inteligente que redujo el tiempo de carga en un 60%.',
    results: ['10k visitas mensuales', '+40% conversión', '99.9% uptime', 'SEO ranking #1'],
    tech: ['Next.js', 'Stripe', 'PostgreSQL', 'Redis', 'AWS'],
    gradient: 'from-purple-500 to-pink-500',
    year: '2024',
    slug: 'ecommerce-premium',
  },
  {
    title: 'App de Gestión',
    category: 'Aplicación Móvil',
    description: 'Aplicación móvil multiplataforma para gestión de equipos y proyectos con sincronización en tiempo real y modo offline.',
    challenge: 'Sincronización confiable de datos entre múltiples usuarios en tiempo real con soporte offline completo.',
    solution: 'Flutter con Firebase Firestore y sistema de resolución de conflictos automático. Implementación de queue local para modo offline.',
    results: ['5k usuarios activos', '4.8★ rating', '-50% tiempo gestión', 'iOS + Android'],
    tech: ['Flutter', 'Firebase', 'REST API', 'SQLite', 'Push Notifications'],
    gradient: 'from-blue-500 to-cyan-500',
    year: '2024',
    slug: 'app-gestion',
  },
  {
    title: 'Dashboard Analytics',
    category: 'Web App',
    description: 'Panel de control con visualización de datos en tiempo real y reportes personalizables para métricas de negocio y KPIs.',
    challenge: 'Renderizar grandes volúmenes de datos sin afectar el rendimiento y permitir personalización total de dashboards.',
    solution: 'React con D3.js para visualizaciones, backend NestJS con WebSockets para datos en tiempo real y caching inteligente.',
    results: ['1M+ data points', '<100ms latency', '50+ dashboards', 'Export a PDF/Excel'],
    tech: ['React', 'D3.js', 'NestJS', 'WebSockets', 'PostgreSQL'],
    gradient: 'from-green-500 to-emerald-500',
    year: '2023',
    slug: 'dashboard-analytics',
  },
  {
    title: 'Landing SaaS',
    category: 'Website',
    description: 'Landing page de alto rendimiento con animaciones fluidas y optimización SEO para producto SaaS B2B.',
    challenge: 'Crear una landing page que cargue en menos de 1 segundo y convierta visitantes en leads cualificados.',
    solution: 'Astro con Islands Architecture, lazy loading de imágenes y formularios integrados con HubSpot.',
    results: ['0.8s load time', '100 Lighthouse', '+35% leads', '60% bounce reduction'],
    tech: ['Astro', 'TailwindCSS', 'Vercel', 'HubSpot', 'Google Analytics'],
    gradient: 'from-orange-500 to-red-500',
    year: '2024',
    slug: 'landing-saas',
  },
  {
    title: 'Fintech App',
    category: 'Aplicación Web',
    description: 'Plataforma fintech para transferencias internacionales con verificación KYC y cumplimiento regulatorio completo.',
    challenge: 'Garantizar máxima seguridad en transacciones financieras y cumplir con regulaciones internacionales.',
    solution: 'Arquitectura de microservicios con NestJS, autenticación 2FA, encriptación end-to-end y auditorías automáticas.',
    results: ['$2M+ procesados', 'PCI DSS compliant', '100% transactions seguras', '15 países'],
    tech: ['NestJS', 'PostgreSQL', 'Redis', 'AWS', 'Microservices'],
    gradient: 'from-indigo-500 to-purple-500',
    year: '2023',
    slug: 'fintech-app',
  },
  {
    title: 'Social Network',
    category: 'Plataforma Social',
    description: 'Red social de nicho para profesionales creativos con sistema de portfolios, mensajería y colaboraciones.',
    challenge: 'Escalar la plataforma para soportar millones de usuarios con contenido multimedia pesado.',
    solution: 'Next.js con ISR, CDN global de Cloudflare, compresión automática de imágenes y video streaming optimizado.',
    results: ['500k usuarios', '10M posts', '99.95% uptime', '<2s page load'],
    tech: ['Next.js', 'GraphQL', 'MongoDB', 'Cloudflare', 'S3'],
    gradient: 'from-pink-500 to-rose-500',
    year: '2023',
    slug: 'social-network',
  },
];

const categories = ['Todos', ...new Set(projects.map(p => p.category))];
---

<Layout
  title="Portfolio"
  description="Explora nuestros proyectos destacados: e-commerce, apps móviles, plataformas web y soluciones empresariales que transformaron negocios."
>
  <Navigation />

  <!-- Hero Section -->
  <section class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black via-gray-900 to-black">
    <div class="max-w-7xl mx-auto text-center">
      <h1 class="text-5xl sm:text-6xl font-bold text-white mb-6">
        Nuestro <span class="bg-linear-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">Portfolio</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto">
        Casos de éxito que demuestran nuestro compromiso con la excelencia. Proyectos reales que generaron resultados medibles.
      </p>
    </div>
  </section>

  <!-- Projects -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-7xl mx-auto">
      <!-- Filter (could be enhanced with JS) -->
      <div class="flex flex-wrap gap-3 justify-center mb-16">
        {categories.map((category) => (
          <button class="px-4 py-2 bg-gray-800 hover:bg-purple-600 text-gray-300 hover:text-white rounded-lg text-sm font-medium transition-all">
            {category}
          </button>
        ))}
      </div>

      <!-- Projects Grid -->
      <div class="space-y-24">
        {projects.map((project, index) => (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            {/* Image/Gradient */}
            <div class={index % 2 === 1 ? 'lg:order-2' : ''}>
              <div class={`h-96 rounded-2xl bg-linear-to-br ${project.gradient} opacity-90 flex flex-col items-center justify-center p-8 relative overflow-hidden`}>
                <div class="absolute inset-0 bg-black/20"></div>
                <div class="relative z-10 text-center">
                  <div class="text-white text-8xl font-bold opacity-30 mb-4">
                    {project.title.substring(0, 2).toUpperCase()}
                  </div>
                  <div class="text-white/80 text-sm font-medium">
                    {project.year}
                  </div>
                </div>
              </div>
            </div>

            {/* Content */}
            <div class={index % 2 === 1 ? 'lg:order-1' : ''}>
              <div class="inline-block px-3 py-1 bg-purple-600/10 text-purple-400 text-xs font-semibold rounded-full mb-4">
                {project.category}
              </div>
              <h2 class="text-4xl font-bold text-white mb-4">{project.title}</h2>
              <p class="text-lg text-gray-300 mb-6">{project.description}</p>

              {/* Challenge & Solution */}
              <div class="space-y-4 mb-6">
                <div>
                  <h3 class="text-sm font-semibold text-purple-400 mb-2">DESAFÍO</h3>
                  <p class="text-gray-400">{project.challenge}</p>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-purple-400 mb-2">SOLUCIÓN</h3>
                  <p class="text-gray-400">{project.solution}</p>
                </div>
              </div>

              {/* Results */}
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-gray-400 mb-3">RESULTADOS</h3>
                <div class="grid grid-cols-2 gap-3">
                  {project.results.map((result) => (
                    <div class="px-4 py-2 bg-gray-900 border border-gray-800 rounded-lg text-center">
                      <div class="text-purple-400 font-bold">{result}</div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Tech Stack */}
              <div class="mb-6">
                <h3 class="text-sm font-semibold text-gray-400 mb-3">TECNOLOGÍAS</h3>
                <div class="flex flex-wrap gap-2">
                  {project.tech.map((tech) => (
                    <span class="px-3 py-1 bg-gray-800 text-gray-300 rounded-md text-sm">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              {/* CTA Button */}
              <a
                href={`/portfolio/${project.slug}`}
                class="inline-flex items-center gap-2 px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50"
              >
                Ver Caso de Estudio Completo
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black to-gray-900">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold text-white mb-4">
        ¿Quieres un proyecto como estos?
      </h2>
      <p class="text-xl text-gray-400 mb-8">
        Hablemos de tu idea y cómo podemos hacerla realidad
      </p>
      <a
        href="/contacto"
        class="inline-flex items-center gap-2 px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50"
      >
        Comenzar mi proyecto
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Simple filter functionality could be added with Alpine.js or vanilla JS */
</style>
