---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/sections/Footer.astro';

const project = {
  title: 'Social Network',
  category: 'Plataforma Social',
  year: '2024',
  client: 'ConnectHub',
  industry: 'Social Media',
  duration: '6 meses',
  team: '8 desarrolladores + 2 DevOps',
};

const challenge = {
  title: 'El Desafío',
  description: 'ConnectHub quería lanzar una red social de nicho que pudiera escalar a millones de usuarios, manejar feeds personalizados en tiempo real, streaming de video en vivo y moderación de contenido con IA, todo mientras mantenía costos de infraestructura controlados.',
  keyPoints: [
    'Escalabilidad para 1M+ usuarios concurrentes',
    'Feed personalizado con algoritmos ML',
    'Streaming de video en vivo (HLS)',
    'Moderación de contenido automatizada con IA',
  ],
};

const solution = {
  title: 'La Solución',
  description: 'Construimos una arquitectura de microservicios con Next.js para el frontend y NestJS para backend. Implementamos GraphQL para queries eficientes, Redis para cache de feeds y AWS MediaLive para streaming. El feed usa recomendaciones con TensorFlow.js. Todo deployado en Kubernetes con auto-scaling.',
  technologies: ['Next.js 14', 'NestJS', 'GraphQL', 'PostgreSQL', 'Redis', 'TensorFlow.js', 'AWS MediaLive', 'Kubernetes', 'Elasticsearch'],
  features: [
    'Feed personalizado con algoritmos ML',
    'Posts multimedia (fotos, videos, audio)',
    'Streaming en vivo con chat interactivo',
    'Stories con 24h de duración',
    'Mensajería directa encriptada',
    'Notificaciones push en tiempo real',
    'Búsqueda avanzada con filtros',
    'Moderación automática de contenido inapropiado',
  ],
};

const results = [
  { metric: '500K+', description: 'Usuarios registrados en 4 meses' },
  { metric: '5M+', description: 'Posts publicados' },
  { metric: '50K+', description: 'Usuarios activos diarios' },
  { metric: '<100ms', description: 'Carga de feed promedio' },
  { metric: '98%', description: 'Precisión en moderación IA' },
  { metric: '99.9%', description: 'Uptime en producción' },
];

const testimonial = {
  quote: 'Black Cat construyó una plataforma social robusta y escalable que compite con las grandes. El feed personalizado y el streaming en vivo funcionan impecablemente.',
  author: 'Michael Chen',
  role: 'Founder & CEO, ConnectHub',
};

const gallery = [
  { title: 'Feed Principal', description: 'Timeline personalizado con posts multimedia' },
  { title: 'Perfil de Usuario', description: 'Página de perfil con estadísticas' },
  { title: 'Live Streaming', description: 'Transmisiones en vivo con chat' },
  { title: 'Mensajería', description: 'Chat directo encriptado' },
];
---

<Layout
  title={`${project.title} - Caso de Éxito | Black Cat`}
  description={`Caso de éxito: ${project.title}. Plataforma social con 500K+ usuarios y streaming en vivo.`}
>
  <Navigation />

  <!-- Hero -->
  <section class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black via-gray-900 to-black">
    <div class="max-w-7xl mx-auto">
      <a href="/portfolio" class="inline-flex items-center gap-2 text-purple-400 hover:text-purple-300 mb-8 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Volver al Portfolio
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-block px-3 py-1 bg-purple-600/10 text-purple-400 text-sm font-semibold rounded-full mb-4">
            {project.category}
          </div>
          <h1 class="text-5xl sm:text-6xl font-bold text-white mb-6">
            {project.title}
          </h1>
          <p class="text-xl text-gray-400 mb-8">
            Red social escalable que alcanzó 500K+ usuarios en 4 meses.
          </p>

          <div class="grid grid-cols-2 gap-6">
            <div>
              <div class="text-sm text-gray-400 mb-1">Cliente</div>
              <div class="text-white font-semibold">{project.client}</div>
            </div>
            <div>
              <div class="text-sm text-gray-400 mb-1">Industria</div>
              <div class="text-white font-semibold">{project.industry}</div>
            </div>
            <div>
              <div class="text-sm text-gray-400 mb-1">Duración</div>
              <div class="text-white font-semibold">{project.duration}</div>
            </div>
            <div>
              <div class="text-sm text-gray-400 mb-1">Año</div>
              <div class="text-white font-semibold">{project.year}</div>
            </div>
          </div>
        </div>

        <div class="h-96 rounded-2xl bg-linear-to-br from-pink-500 to-rose-500 opacity-90 flex items-center justify-center">
          <div class="text-white text-9xl font-bold opacity-30">SN</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Challenge -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">{challenge.title}</h2>
      <p class="text-xl text-gray-300 leading-relaxed mb-8">
        {challenge.description}
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {challenge.keyPoints.map((point) => (
          <div class="flex items-start gap-3 bg-gray-900 border border-gray-800 rounded-lg p-4">
            <svg class="w-6 h-6 text-purple-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-gray-300">{point}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black to-gray-900">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">{solution.title}</h2>
      <p class="text-xl text-gray-300 leading-relaxed mb-8">
        {solution.description}
      </p>

      <div class="mb-8">
        <h3 class="text-xl font-bold text-white mb-4">Stack Tecnológico</h3>
        <div class="flex flex-wrap gap-3">
          {solution.technologies.map((tech) => (
            <span class="px-4 py-2 bg-gray-900 border border-gray-800 text-gray-300 rounded-lg text-sm">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-xl font-bold text-white mb-4">Features Implementadas</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {solution.features.map((feature) => (
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-purple-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-300 text-sm">{feature}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Results -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-12 text-center">Resultados</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
        {results.map((result) => (
          <div class="text-center">
            <div class="text-4xl font-bold bg-linear-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent mb-2">
              {result.metric}
            </div>
            <div class="text-gray-400 text-sm">{result.description}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black to-gray-900">
    <div class="max-w-4xl mx-auto">
      <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8 md:p-12 relative">
        <div class="absolute top-8 right-8 text-6xl text-purple-600/10">"</div>
        <p class="text-2xl text-gray-300 leading-relaxed mb-8 relative">
          {testimonial.quote}
        </p>
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-linear-to-br from-pink-600 to-rose-600 rounded-full flex items-center justify-center text-white font-bold">
            {testimonial.author.charAt(0)}
          </div>
          <div>
            <div class="text-white font-semibold">{testimonial.author}</div>
            <div class="text-gray-400 text-sm">{testimonial.role}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-black">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-12 text-center">Capturas del Proyecto</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {gallery.map((item, index) => (
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-purple-600 transition-all">
            <div class={`h-48 rounded-lg bg-linear-to-br from-pink-${500 + index * 100} to-rose-${500 + index * 100} opacity-70 flex items-center justify-center mb-4`}>
              <div class="text-white text-4xl font-bold opacity-30">{index + 1}</div>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">{item.title}</h3>
            <p class="text-gray-400 text-sm">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-black to-gray-900">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold text-white mb-4">
        ¿Quieres construir una plataforma social?
      </h2>
      <p class="text-xl text-gray-400 mb-8">
        Desarrollamos redes sociales escalables y modernas
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contacto" class="px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-all shadow-lg shadow-purple-900/50">
          Comenzar Proyecto
        </a>
        <a href="/portfolio" class="px-8 py-4 border-2 border-purple-600 text-purple-400 hover:bg-purple-600 hover:text-white rounded-lg font-medium transition-all">
          Ver Más Proyectos
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
